// トピあつめのアクセス解析のサーバー（Cloudflare Workers）の設定。公開は GitHub Actions（.github/workflows/analytics.yml）が行う。
// 公開しているサイトからは、Cloudflare Pages の Functions（サイトと同じドメインの /api）がこの Worker の Durable Object を直接使うので、
// この Worker 自体は workers.dev で公開しない（ALLOWED_ORIGINS は手元で wrangler dev で試すときだけ使う）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topiatsume-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ANALYTICS", "class_name": "Analytics" }]
  },
  // 無料プランで使える SQLite の Durable Object
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Analytics"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4321",
    "REPOSITORY": "nomixio260-a11y/matmsait",
    "MAX_EVENTS_PER_DAY": "40000",
    // 公開しているサイト（通知の送り主の連絡先。独自ドメインにしたら analytics.yml が変数 SITE_URL で上書きする）
    "SITE_URL": "https://topiatsume.pages.dev",
    "MAX_PUSH_SUBSCRIBERS": "20000"
  }
}

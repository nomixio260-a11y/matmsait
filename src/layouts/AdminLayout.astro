---
import '../styles/global.css';
import '../styles/items.css';
import { site } from '../config/site.ts';
import { analyticsUrlOverride } from '../config/services.ts';
import { analyticsEndpoint } from '../lib/analytics-config.ts';
import { href } from '../lib/items.ts';

interface Props {
  title: string;
  /** ログイン中の表示（ログイン名・ログアウト）を出すか */
  showUser?: boolean;
  /** 管理画面のページの切り替えで強調するもの */
  current?: 'summaries' | 'analytics';
}
const { title, showUser = true, current } = Astro.props;
// アクセス解析のサーバー（設定されていれば、管理画面からの通信先に加える）
const analytics = analyticsEndpoint(analyticsUrlOverride);

/**
 * 管理画面のコンテンツセキュリティポリシー。読み込めるのは自分のサイトのファイルだけで、通信先は GitHub API と
 * 運営者のアクセス解析のサーバーだけにする（万一、外部から入った文字列がスクリプトとして動いても、トークンをほかへ送れないようにするため）。
 * GitHub Pages ではレスポンスヘッダーを設定できないので meta で指定する（枠への埋め込みの禁止はスクリプトで行う）
 */
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  // 小さなスタイルシートはビルド時にページへ埋め込まれることがあるため、スタイルだけは埋め込みを許す
  // （画像の読み込み先を制限しているので、スタイルから外へ情報を送ることもできない）
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https://www.google.com https://*.gstatic.com",
  `connect-src 'self' https://api.github.com${analytics ? ` ${analytics}` : ''}`,
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
].join('; ');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}｜{site.name} 管理画面</title>
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body data-base={href('')} data-analytics={analytics || undefined}>
    <header class="admin-bar">
      <div class="container admin-bar-inner">
        <a class="admin-brand" href={href('/')}>{site.name}</a>
        <span class="admin-label">管理画面</span>
        {
          showUser && (
            <span class="admin-user" data-admin-user hidden>
              <span class="admin-login" data-admin-login />
              <button type="button" class="admin-logout" data-logout>
                ログアウト
              </button>
            </span>
          )
        }
        <a class="admin-back" href={href('/')}>サイト<span class="wide">を見る</span> →</a>
      </div>
      {
        current && (
          <nav class="container admin-nav" aria-label="管理画面のページ">
            <a href={href('/admin/')} aria-current={current === 'summaries' ? 'page' : undefined}>
              AI要約の管理
            </a>
            <a href={href('/admin/analytics/')} aria-current={current === 'analytics' ? 'page' : undefined}>
              アクセス解析
            </a>
          </nav>
        )
      }
    </header>
    <main class="container admin-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .admin-bar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .admin-bar-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
  }
  .admin-brand {
    font-weight: 800;
    text-decoration: none;
    color: var(--accent);
  }
  .admin-brand,
  .admin-label,
  .admin-logout,
  .admin-back {
    flex-shrink: 0;
    white-space: nowrap;
  }
  .admin-label {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .admin-user {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-2);
  }
  .admin-login {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .admin-user[hidden] {
    display: none;
  }
  .admin-login::before {
    content: '●';
    margin-right: 4px;
    color: #16a34a;
  }
  .admin-logout {
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-2);
    font: inherit;
    padding: 3px 10px;
    cursor: pointer;
  }
  .admin-logout:hover {
    border-color: var(--hot);
    color: var(--hot);
  }
  .admin-back {
    margin-left: auto;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
  }
  .admin-user:not([hidden]) + .admin-back {
    margin-left: 4px;
  }
  @media (max-width: 480px) {
    .admin-login,
    .admin-back .wide {
      display: none;
    }
  }
  .admin-nav {
    display: flex;
    gap: 4px;
    overflow-x: auto;
  }
  .admin-nav a {
    padding: 8px 14px;
    border-bottom: 3px solid transparent;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .admin-nav a:hover {
    color: var(--accent);
  }
  .admin-nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }
  .admin-main {
    max-width: 1000px;
    padding-top: 20px;
    padding-bottom: 64px;
  }
</style>

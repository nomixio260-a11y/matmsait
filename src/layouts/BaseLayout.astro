---
import { site } from '../config/site.ts';
import { adsenseClient } from '../config/ads.ts';
import { href } from '../lib/items.ts';
import CategoryNav from '../components/CategoryNav.astro';

interface Props {
  title?: string;
  description?: string;
  /** 現在のカテゴリ（ナビのハイライト用） */
  current?: string;
  noindex?: boolean;
}

const { title, description = site.description, current, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={href('/rss.xml')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    {
      adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={href('/')}>{site.name}</a>
        <p class="tagline">いろんなサイトの新着をまとめてチェック</p>
      </div>
      <CategoryNav current={current} />
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav class="footer-links" aria-label="サイト情報">
          <a href={href('/about/')}>このサイトについて</a>
          <a href={href('/sources/')}>掲載元一覧</a>
          <a href={href('/privacy/')}>プライバシーポリシー</a>
          <a href={href('/contact/')}>お問い合わせ</a>
          <a href={href('/rss.xml')}>RSS</a>
        </nav>
        <p class="note">
          掲載している記事の見出し・抜粋の著作権は各配信元に帰属します。記事本文は各リンク先でご覧ください。
        </p>
        <p class="copy">&copy; {year} {site.name}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f7f9;
    --surface: #ffffff;
    --text: #1d2129;
    --muted: #5d6573;
    --border: #e3e6eb;
    --accent: #d9480f;
    --accent-soft: #fff1e8;
    --link-visited: #6b4fa3;
    --radius: 10px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #121418;
      --surface: #1b1e24;
      --text: #e7e9ee;
      --muted: #9aa2b1;
      --border: #2c313a;
      --accent: #ff8a4c;
      --accent-soft: #2f2118;
      --link-visited: #b9a2e6;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #121418;
    --surface: #1b1e24;
    --text: #e7e9ee;
    --muted: #9aa2b1;
    --border: #2c313a;
    --accent: #ff8a4c;
    --accent-soft: #2f2118;
    --link-visited: #b9a2e6;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Noto Sans JP', 'Yu Gothic UI', sans-serif;
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
  }
  a {
    color: inherit;
  }
  .container {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
  }
  main.container {
    padding-top: 20px;
    padding-bottom: 40px;
  }
  h1 {
    font-size: 1.4rem;
    margin: 0 0 4px;
  }
  h2 {
    font-size: 1.15rem;
    margin: 0;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 16px;
    font-size: 0.9rem;
  }

  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-top: 12px;
    padding-bottom: 4px;
    flex-wrap: wrap;
  }
  .logo {
    font-weight: 800;
    font-size: 1.3rem;
    text-decoration: none;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 24px 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 12px;
  }
  .footer-links a {
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
  .site-footer .note,
  .site-footer .copy {
    margin: 4px 0;
  }

  .prose {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .prose h2 {
    margin-top: 24px;
    margin-bottom: 8px;
  }
  .prose a {
    color: var(--accent);
  }
</style>

---
import '../styles/global.css';
import '../styles/items.css';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../config/site.ts';
import {
  adsenseClient,
  bingSiteVerification,
  gaMeasurementId,
  googleSiteVerification,
} from '../config/services.ts';
import { href } from '../lib/items.ts';

interface Props {
  title?: string;
  description?: string;
  /** ヘッダーのタブで強調する項目（'' は総合） */
  current?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  /** サイドバーを出すか。カテゴリを渡すとランキングをそのカテゴリに絞る */
  sidebar?: boolean | { category?: string; hideRanking?: boolean; rankingWideOnly?: boolean };
  /** ページ固有の構造化データ */
  jsonLd?: Record<string, unknown>[];
  /** サイト全体のRSSに加えて案内するフィード */
  feeds?: { title: string; path: string }[];
}

const {
  title,
  description = site.description,
  current,
  noindex = false,
  breadcrumbs,
  sidebar = true,
  jsonLd = [],
  feeds = [],
} = Astro.props;
const pageTitle = title ? `${title}｜${site.name}` : `${site.name}｜${site.seoTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(href('/og.png'), Astro.site).toString();
const sidebarProps = typeof sidebar === 'object' ? sidebar : {};
const toJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16191e" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}｜${site.seoTitle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}（新着記事）`} href={href('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}（日別まとめ）`} href={href('/daily/rss.xml')} />
    {
      feeds.map((feed) => (
        <link rel="alternate" type="application/rss+xml" title={`${site.name}（${feed.title}）`} href={href(feed.path)} />
      ))
    }
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://www.google.com" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={toJson(data)} />)}
    <script is:inline>
      try {
        var theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
    {
      adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      gaMeasurementId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaMeasurementId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header current={current} />
    <div class:list={['container', 'layout', { 'has-sidebar': sidebar !== false }]}>
      <main id="main" class="main">
        {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
        <slot />
      </main>
      {sidebar !== false && <Sidebar {...sidebarProps} />}
    </div>
    <Footer />

    <script>
      // ===== 表示テーマの切り替え =====
      const root = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : prefersDark.matches);

      function syncThemeButtons() {
        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
          button.setAttribute('aria-label', isDark() ? 'ライトモードに切り替え' : 'ダークモードに切り替え');
        }
      }
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        button.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {
            // 保存できない環境でも切り替え自体は効く
          }
          syncThemeButtons();
        });
      }
      prefersDark.addEventListener('change', syncThemeButtons);
      syncThemeButtons();

      // ===== 「◯分前」表示と NEW マーク（静的ページなので閲覧時に計算する） =====
      const MINUTE = 60_000;
      const HOUR = 60 * MINUTE;

      function updateRelativeTimes() {
        const now = Date.now();
        for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-rel]')) {
          const time = Date.parse(el.dateTime);
          if (Number.isNaN(time)) continue;
          const diff = now - time;
          if (diff < HOUR) el.textContent = diff < MINUTE ? 'たった今' : `${Math.floor(diff / MINUTE)}分前`;
          else if (diff < 24 * HOUR) el.textContent = `${Math.floor(diff / HOUR)}時間前`;
          el.closest('.item')?.classList.toggle('is-new', diff < HOUR);
        }
      }
      updateRelativeTimes();
      setInterval(updateRelativeTimes, MINUTE);

      // ===== 選択中のタブが見えるようにスクロール =====
      document.querySelector('.tabs [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    </script>
  </body>
</html>

---
import '../styles/global.css';
import '../styles/items.css';
import '../styles/personal.css';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../config/site.ts';
import {
  adsenseClient,
  analyticsUrlOverride,
  bingSiteVerification,
  gaMeasurementId,
  googleSiteVerification,
} from '../config/services.ts';
import { analyticsEndpoint } from '../lib/analytics-config.ts';
import { getNotice } from '../lib/editorial.ts';
import { builtAt, href } from '../lib/items.ts';

interface Props {
  title?: string;
  description?: string;
  /** ヘッダーのタブで強調する項目（'' は総合） */
  current?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  /** サイドバーを出すか。カテゴリを渡すとランキングをそのカテゴリに絞る */
  sidebar?: boolean | { category?: string; hideRanking?: boolean; rankingWideOnly?: boolean; hidePopular?: boolean };
  /** ページ固有の構造化データ */
  jsonLd?: Record<string, unknown>[];
  /** サイト全体のRSSに加えて案内するフィード */
  feeds?: { title: string; path: string }[];
  /** 記事のページ（要約・話題）では article にして、公開・更新の日時を OGP に入れる */
  ogType?: 'website' | 'article';
  /** ページの内容の公開日時・最終更新日時（ISO 8601。og:type が article のとき） */
  published?: string;
  modified?: string;
}

const {
  title,
  description = site.description,
  current,
  noindex = false,
  breadcrumbs,
  sidebar = true,
  jsonLd = [],
  feeds = [],
  ogType = 'website',
  published,
  modified,
} = Astro.props;
const pageTitle = title ? `${title}｜${site.name}` : `${site.name}｜${site.seoTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(href('/og.png'), Astro.site).toString();
const sidebarProps = typeof sidebar === 'object' ? sidebar : {};
const toJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
// アクセス解析のサーバー（設定されていなければ計測しない）
const analytics = analyticsEndpoint(analyticsUrlOverride);
// 運営からのお知らせ（掲載期間のうちだけ。管理画面から設定する）
const notice = getNotice();
const noticeLink = notice?.url ? (notice.url.startsWith('/') ? href(notice.url) : notice.url) : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16191e" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}｜${site.seoTitle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}（新着記事）`} href={href('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}（日別まとめ）`} href={href('/daily/rss.xml')} />
    {
      feeds.map((feed) => (
        <link rel="alternate" type="application/rss+xml" title={`${site.name}（${feed.title}）`} href={href(feed.path)} />
      ))
    }
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://www.google.com" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={toJson(data)} />)}
    <script is:inline>
      // 表示テーマと表示の設定（文字の大きさ・抜粋・既読）を、表示が始まる前に反映する（ちらつかないように）
      try {
        var root = document.documentElement;
        var theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        var display = JSON.parse(localStorage.getItem('matmsait:display') || '{}');
        if (display.font === 'l' || display.font === 'xl') root.dataset.font = display.font;
        if (display.excerpt === false) root.dataset.excerpt = 'off';
        root.dataset.read = display.read === 'hide' || display.read === 'off' ? display.read : 'mark';
      } catch (e) {}
    </script>
    {
      adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      gaMeasurementId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaMeasurementId);
          </script>
        </>
      )
    }
  </head>
  <body data-base={href('')} data-built={builtAt.toISOString()} data-analytics={analytics || undefined}>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <svg class="icon-sprite" width="0" height="0" aria-hidden="true" focusable="false">
      <symbol id="i-save" viewBox="0 0 24 24">
        <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
      </symbol>
      <symbol id="i-more" viewBox="0 0 24 24">
        <circle cx="5" cy="12" r="1.8" fill="currentColor"></circle>
        <circle cx="12" cy="12" r="1.8" fill="currentColor"></circle>
        <circle cx="19" cy="12" r="1.8" fill="currentColor"></circle>
      </symbol>
    </svg>
    <Header current={current} />
    {
      notice && (
        <aside
          class:list={['notice-bar', { 'is-important': notice.level === 'important' }]}
          aria-label="運営からのお知らせ"
          data-notice={notice.id}
          data-end={notice.end}
        >
          <div class="container notice-inner">
            <span class="notice-label">{notice.level === 'important' ? '重要' : 'お知らせ'}</span>
            <p class="notice-text">
              {notice.text}
              {noticeLink && (
                <>
                  {' '}
                  <a href={noticeLink} {...(noticeLink.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                    詳しく見る
                  </a>
                </>
              )}
            </p>
            <button type="button" class="notice-close" data-notice-close aria-label="お知らせを閉じる">
              ×
            </button>
          </div>
        </aside>
      )
    }
    {
      notice && (
        <script is:inline>
          // 閉じたお知らせ・掲載期間の終わったお知らせは、表示する前に隠す
          (function () {
            var bar = document.currentScript && document.currentScript.previousElementSibling;
            try {
              if (bar && (localStorage.getItem('matmsait:notice-dismissed') === JSON.stringify(bar.dataset.notice) || Date.parse(bar.dataset.end) < Date.now())) bar.hidden = true;
            } catch (e) {}
          })();
        </script>
      )
    }
    <div class:list={['container', 'layout', { 'has-sidebar': sidebar !== false }]}>
      <main id="main" class="main">
        {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
        <slot />
      </main>
      {sidebar !== false && <Sidebar {...sidebarProps} />}
    </div>
    <Footer />

    <script>
      // あとで読む・前回の訪問以降の新着（閲覧者のブラウザにだけ保存）
      import { visitInfo } from '../scripts/reader.ts';
      // フォロー・表示しない設定・既読・表示の設定・お知らせ（閲覧者のブラウザにだけ保存）
      import '../scripts/personal.ts';
      import { startAnalytics } from '../scripts/analytics.ts';
      // ホーム画面への追加（PWA）・オフラインでの表示
      import { registerServiceWorker, setupInstallPrompt } from '../scripts/pwa.ts';

      // ===== アクセス解析（運営者のサーバーに、見たページ・開いた記事などを送る。Cookie は使わない） =====
      const analyticsEndpoint = document.body.dataset.analytics;
      if (analyticsEndpoint) startAnalytics(analyticsEndpoint, visitInfo());

      // ===== サービスワーカー（オフライン・通知）と「ホーム画面に追加」の案内（前にも来た人だけ） =====
      registerServiceWorker(document.body.dataset.base ?? '', analyticsEndpoint ?? '');
      setupInstallPrompt(visitInfo().returning);

      // ===== 期間などの切り替えタブ（話題のニュース・よく読まれている記事） =====
      const segTabs = document.querySelectorAll<HTMLButtonElement>('.seg [role="tab"]');
      for (const tab of segTabs) {
        tab.addEventListener('click', () => {
          for (const other of tab.closest('.seg')?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []) {
            const selected = other === tab;
            other.setAttribute('aria-selected', String(selected));
            const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
            if (panel) panel.hidden = !selected;
          }
        });
      }

      // ===== 表示テーマの切り替え =====
      const root = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : prefersDark.matches);

      function syncThemeButtons() {
        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
          button.setAttribute('aria-label', isDark() ? 'ライトモードに切り替え' : 'ダークモードに切り替え');
        }
      }
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        button.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {
            // 保存できない環境でも切り替え自体は効く
          }
          syncThemeButtons();
        });
      }
      prefersDark.addEventListener('change', syncThemeButtons);
      syncThemeButtons();

      // ===== 「◯分前」表示と NEW マーク（ビルドした時点の表示を、閲覧時の時刻で書き直す） =====
      const MINUTE = 60_000;
      const HOUR = 60 * MINUTE;
      const timeFormat = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', hour: '2-digit', minute: '2-digit' });
      const dateTimeFormat = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });

      function updateRelativeTimes() {
        const now = Date.now();
        for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-rel]')) {
          const time = Date.parse(el.dateTime);
          if (Number.isNaN(time)) continue;
          const diff = now - time;
          // 24時間より前は日時で（日付ごとに分けた一覧では時刻だけ）
          const text =
            diff < HOUR
              ? diff < MINUTE
                ? 'たった今'
                : `${Math.floor(diff / MINUTE)}分前`
              : diff < 24 * HOUR
                ? `${Math.floor(diff / HOUR)}時間前`
                : (el.dataset.rel === 't' ? timeFormat : dateTimeFormat).format(time);
          if (el.textContent !== text) el.textContent = text;
          el.closest('.item')?.classList.toggle('is-new', diff < HOUR);
        }
      }
      updateRelativeTimes();
      setInterval(updateRelativeTimes, MINUTE);

      // ===== 選択中のタブが見えるようにスクロール =====
      document.querySelector('.tabs [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    </script>
  </body>
</html>

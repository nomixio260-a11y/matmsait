---
/** 注目ワード（直近24時間の見出しに急に増えた言葉）。押すとキーワードのページ（なければサイト内検索）、タグの言葉はタグのページへ */
import { tags } from '../config/tags.ts';
import { href } from '../lib/items.ts';
import { normalizeWord, type TrendWord } from '../lib/topic-core.ts';
import { paceText, tagPath } from '../lib/topics.ts';
import { wordHref } from '../lib/words.ts';

interface Props {
  words: TrendWord[];
}
const { words } = Astro.props;
// タグの言葉そのものなら、タグのページへ（記事がまとまっていて検索より見やすい）
const tagByWord = new Map(tags.flatMap((tag) => [tag.name, ...tag.words].map((word) => [normalizeWord(word), tag.slug] as const)));
---

<ol class="trend-words">
  {
    words.map((word, index) => {
      const tag = tagByWord.get(normalizeWord(word.word));
      const link = href(tag ? tagPath(tag) : wordHref(word.word));
      return (
        <li>
          <a
            href={link}
            title={`24時間で${word.count}件の見出しに登場（${word.sources}媒体）。${word.baseline > 0 ? `ふだん（それまでの6日間の平均）の${paceText(word.count / word.baseline)}` : 'それまでの6日間はほとんど出てこなかった言葉'}`}
          >
            <span class="trend-rank">{index + 1}</span>
            <span class="trend-word">{word.word}</span>
            <span class="trend-count">{word.count}件</span>
            {word.baseline > 0 ? (
              <span class="trend-up">×{paceText(word.count / word.baseline).replace('倍', '')}</span>
            ) : (
              <span class="trend-up">新</span>
            )}
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .trend-words {
    list-style: none;
    margin: 0;
    padding: 12px 16px 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .trend-words a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px 0 6px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }
  .trend-words a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .trend-rank {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .trend-words li:nth-child(-n + 3) .trend-rank {
    background: var(--text);
    color: var(--surface);
  }
  .trend-count {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
  }
  /* ふだんと比べた増え方（急に増えた＝急上昇の色） */
  .trend-up {
    color: var(--rise);
    font-size: 0.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
</style>

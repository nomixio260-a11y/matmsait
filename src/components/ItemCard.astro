---
import { getCategory, getSource, formatDate, href } from '../lib/items.ts';
import type { Item } from '../lib/types.ts';

interface Props {
  item: Item;
  showCategory?: boolean;
}
const { item, showCategory = false } = Astro.props;
const source = getSource(item.sourceId);
const category = getCategory(item.category);
const host = new URL(item.url).hostname.replace(/^www\./, '');
---

<article class="item">
  <h3 class="title">
    <a href={item.url} target="_blank" rel="noopener">{item.title}</a>
  </h3>
  {item.excerpt && <p class="excerpt">{item.excerpt}</p>}
  <p class="meta">
    {source && <a class="source" href={href(`/source/${source.id}/`)}>{source.name}</a>}
    {
      showCategory && category && (
        <a class="category" href={href(`/category/${category.slug}/`)}>
          {category.name}
        </a>
      )
    }
    <span class="host">{host}</span>
    <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
  </p>
</article>

<style>
  .item {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .item:last-child {
    border-bottom: none;
  }
  .title {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 4px;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
    color: var(--accent);
  }
  .title a:visited {
    color: var(--link-visited);
  }
  .excerpt {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .meta a {
    text-decoration: none;
  }
  .meta a:hover {
    text-decoration: underline;
  }
  .source {
    font-weight: 600;
    color: var(--text);
  }
  .category {
    color: var(--accent);
  }
</style>

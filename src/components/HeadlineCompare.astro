---
/**
 * 各媒体の見出しの比較（AI を使わない、機械的な比較）。AI 整理がないトピックで「各メディアの視点」として出す。
 * 共通する言葉・その見出しにだけある言葉・見出しの数字の違い（判断はしない）
 */
import Icon from './Icon.astro';
import { faviconUrl, siteOf } from '../lib/items.ts';
import { compareHeadlines } from '../lib/headline-compare.ts';
import type { TopicView } from '../lib/topics.ts';

interface Props {
  view: TopicView;
}
const { view } = Astro.props;
const headlines = view.reports.map((report) => report.item);
const result = compareHeadlines(headlines.map((item) => ({ id: item.id, title: item.title })));
const siteLabel = (id: string) => {
  const item = headlines.find((entry) => entry.id === id);
  return item ? siteOf(item).label : '';
};
---

<div class="compare">
  {
    result.common.length > 0 && (
      <div class="compare-common">
        <h3>多くの見出しに共通する言葉</h3>
        <ul class="word-chips">
          {result.common.map((word) => (
            <li>{word}</li>
          ))}
        </ul>
      </div>
    )
  }
  <h3>各媒体の見出し<small>（報じた順。その見出しにだけある言葉は、その媒体が焦点を当てている点の手がかりです）</small></h3>
  <ul class="headlines">
    {
      headlines.map((item) => {
        const site = siteOf(item);
        const unique = result.unique[item.id] ?? [];
        return (
          <li>
            <span class="headline-site">
              <img src={faviconUrl(site.host)} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              {site.label}
            </span>
            <a class="headline-title" href={item.url} target="_blank" rel="noopener" data-aid={item.id} data-src={item.sourceId} data-cat={item.category}>
              {item.title}
            </a>
            {unique.length > 0 && (
              <p class="headline-unique">
                <span>この見出しだけ:</span>
                {unique.map((word) => (
                  <mark>{word}</mark>
                ))}
              </p>
            )}
          </li>
        );
      })
    }
  </ul>
  {
    result.numbers.length > 0 && (
      <div class="compare-numbers" role="note">
        <p class="numbers-title">
          <Icon name="info" />
          見出しの数字が媒体によって違います
        </p>
        <ul>
          {result.numbers.map((difference) => (
            <li>
              {difference.values.map((value, index) => (
                <>
                  {index > 0 && <span class="sep">／</span>}
                  <b>{value.text}</b>（{value.ids.map(siteLabel).join('・')}）
                </>
              ))}
            </li>
          ))}
        </ul>
        <p class="numbers-note">同じものを指しているとは限らず、どちらが正しいかは判断していません。各媒体の記事で確かめてください。</p>
      </div>
    )
  }
  <p class="compare-note">見出しの言葉を機械的に比べたものです。記事の内容の違いを示すものではありません。</p>
</div>

<style>
  .compare {
    padding: 12px 16px 14px;
  }
  .compare h3 {
    margin: 0 0 8px;
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 800;
  }
  .compare h3 small {
    margin-left: 4px;
    color: var(--muted);
    font-size: var(--fs-caption);
    font-weight: 400;
  }
  .compare-common {
    margin-bottom: 14px;
  }
  .word-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
  }
  .word-chips li {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--text-2);
    font-size: var(--fs-caption);
    font-weight: 700;
  }
  .headlines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .headlines li {
    padding: 10px 0;
  }
  .headlines li + li {
    border-top: 1px solid var(--border);
  }
  .headline-site {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: var(--fs-caption);
    font-weight: 700;
  }
  .headline-site img {
    border-radius: 3px;
  }
  .headline-title {
    display: block;
    margin-top: 2px;
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 700;
    line-height: 1.6;
    text-decoration: none;
  }
  .headline-title:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .headline-unique {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin: 4px 0 0;
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  .headline-unique mark {
    padding: 0 6px;
    border-radius: 4px;
    background: var(--rise-soft);
    color: var(--rise);
    font-weight: 700;
  }
  .compare-numbers {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--warn-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--warn) 35%, var(--border));
    font-size: var(--fs-small);
  }
  .numbers-title {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--warn);
    font-weight: 800;
  }
  .compare-numbers ul {
    margin: 6px 0 0;
    padding-left: 1.2em;
    color: var(--text-2);
    line-height: 1.7;
  }
  .compare-numbers .sep {
    margin: 0 4px;
    color: var(--muted);
  }
  .numbers-note,
  .compare-note {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: var(--fs-caption);
    line-height: 1.6;
  }
</style>

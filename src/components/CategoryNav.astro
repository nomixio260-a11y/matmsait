---
import { categories } from '../config/site.ts';
import { href } from '../lib/items.ts';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const links = [{ slug: '', name: '総合', path: '/' }].concat(
  categories.map((c) => ({ slug: c.slug, name: c.name, path: `/category/${c.slug}/` })),
);
---

<nav class="category-nav" aria-label="カテゴリ">
  <ul class="container">
    {
      links.map((link) => (
        <li>
          <a href={href(link.path)} aria-current={(current ?? '') === link.slug ? 'page' : undefined}>
            {link.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .category-nav ul {
    list-style: none;
    margin: 0 auto;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-top: 4px;
    padding-bottom: 8px;
  }
  .category-nav ul::-webkit-scrollbar {
    display: none;
  }
  a {
    display: block;
    white-space: nowrap;
    padding: 4px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--muted);
  }
  a:hover {
    background: var(--bg);
    color: var(--text);
  }
  a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
  }
</style>

---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="var(--accent)"></rect>
  <rect x="7.5" y="8.5" width="17" height="3.2" rx="1.6" fill="#fff"></rect>
  <rect x="7.5" y="14.4" width="12" height="3.2" rx="1.6" fill="#fff" opacity="0.85"></rect>
  <rect x="7.5" y="20.3" width="7.5" height="3.2" rx="1.6" fill="#fff" opacity="0.7"></rect>
  <circle cx="22.2" cy="21.9" r="2.7" fill="#fff"></circle>
</svg>

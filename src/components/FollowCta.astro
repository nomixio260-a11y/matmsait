---
/**
 * SNS のフォローの案内（Bluesky に急上昇・いま話題のニュースを自動で投稿している）。
 * サイトに来た人が SNS でもフォローすると、タイムラインからまた来てもらえる
 */
import { site } from '../config/site.ts';

interface Props {
  /** 案内の文（何が届くか） */
  text?: string;
}
const { text = '急上昇・いま話題のニュースを、Bluesky のタイムラインにお届けします。' } = Astro.props;
const bluesky = site.socialAccounts.find((account) => account.name === 'Bluesky');
---

{
  bluesky && (
    <aside class="follow-cta" aria-label="Bluesky でフォロー">
      <svg class="follow-cta-icon" width="28" height="25" viewBox="0 0 64 57" aria-hidden="true">
        <path
          fill="currentColor"
          d="M13.873 3.805C21.21 9.332 29.103 20.537 32 26.55v15.882c0-.338-.13.044-.41.867-1.512 4.456-7.418 21.847-20.923 7.944-7.111-7.32-3.819-14.64 9.125-16.85-7.405 1.264-15.73-.825-18.014-9.015C1.12 23.022 0 8.51 0 6.55 0-3.268 8.579-.182 13.873 3.805ZM50.127 3.805C42.79 9.332 34.897 20.537 32 26.55v15.882c0-.338.13.044.41.867 1.512 4.456 7.418 21.847 20.923 7.944 7.111-7.32 3.819-14.64-9.125-16.85 7.405 1.264 15.73-.825 18.014-9.015C62.88 23.022 64 8.51 64 6.55c0-9.818-8.578-6.732-13.873-2.745Z"
        ></path>
      </svg>
      <p class="follow-cta-text">{text}</p>
      <a class="follow-cta-link" href={bluesky.url} target="_blank" rel="noopener me">Bluesky でフォロー</a>
    </aside>
  )
}

<style>
  .follow-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .follow-cta-icon {
    flex: none;
    color: #1185fe;
  }
  .follow-cta-text {
    flex: 1;
    min-width: 12em;
    margin: 0;
    color: var(--text-2);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .follow-cta-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    /* Bluesky の青を少し濃くして、白い文字との差（コントラスト 4.5:1 以上）を確保する */
    background: #0a6fe0;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
  }
  .follow-cta-link:hover {
    background: #0560c4;
  }
</style>

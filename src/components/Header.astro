---
import Logo from './Logo.astro';
import { categories, site } from '../config/site.ts';
import { href } from '../lib/items.ts';

interface Props {
  /** 現在のタブ（'' は総合、'ranking'、またはカテゴリの slug） */
  current?: string;
}
const { current } = Astro.props;
const tabs = [
  { key: '', name: '総合', path: '/' },
  { key: 'ranking', name: 'ランキング', path: '/ranking/' },
  ...categories.map((c) => ({ key: c.slug, name: c.name, path: `/category/${c.slug}/` })),
];
---

<header class="masthead">
  <div class="container masthead-inner">
    <a class="brand" href={href('/')}>
      <Logo />
      <span class="brand-name">{site.name}</span>
    </a>
    <p class="brand-tagline">{site.tagline}</p>
    <form class="search" role="search" aria-label="サイト内検索" action={href('/search/')} method="get">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input type="search" name="q" placeholder="記事を検索" aria-label="記事を検索" autocomplete="off" />
    </form>
    <a class="icon-btn search-link" href={href('/search/')} aria-label="記事を検索">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </a>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="表示テーマを切り替え">
      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<nav class="tabs" aria-label="メインメニュー">
  <div class="container">
    <ul>
      {
        tabs.map((tab) => (
          <li>
            <a href={href(tab.path)} aria-current={current === tab.key ? 'page' : undefined}>
              {tab.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .masthead {
    background: var(--surface);
  }
  .masthead-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex: none;
  }
  .brand-name {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .brand-tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    display: none;
    white-space: nowrap;
  }
  .search {
    display: none;
    margin-left: auto;
    position: relative;
    width: min(320px, 40vw);
  }
  .search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    height: 36px;
    padding: 0 12px 0 34px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
  }
  .search input:focus {
    outline: 2px solid var(--focus);
    outline-offset: 0;
    background: var(--surface);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    flex: none;
  }
  .icon-btn:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .search-link {
    margin-left: auto;
  }
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  @media (min-width: 720px) {
    .search {
      display: block;
    }
    .search-link {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .brand-tagline {
      display: block;
    }
  }

  .tabs {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .tabs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
  }
  .tabs ul::-webkit-scrollbar {
    display: none;
  }
  .tabs a {
    display: block;
    position: relative;
    padding: 11px 12px;
    line-height: 22px;
    white-space: nowrap;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .tabs a:hover {
    color: var(--text);
  }
  .tabs a[aria-current='page'] {
    color: var(--accent);
  }
  .tabs a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--accent);
  }
  @media (min-width: 1000px) {
    .tabs ul {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>

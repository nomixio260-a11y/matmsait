---
/**
 * 今日のニュースの温度: ジャンルごとのトピックの熱さ（話題度のもとになる値の合計）を横棒で並べる。
 * 記事の数ではなく、報じた媒体の数・新しさ・広がりを合わせた「話題の熱さ」で比べる。昨日の同じ時刻との比較つき
 */
import Icon from './Icon.astro';
import { href } from '../lib/items.ts';
import { getGenreTemperature } from '../lib/topics.ts';

interface Props {
  /** 何ジャンルまで出すか */
  limit?: number;
}
const { limit = 9 } = Astro.props;
const genres = getGenreTemperature()
  .filter((genre) => genre.topics > 0 || genre.previousTopics > 0)
  .slice(0, limit);
const max = Math.max(...genres.map((genre) => genre.heat), 0.001);
const trendText = { up: '昨日の同じ時刻より上昇', down: '昨日の同じ時刻より低下', flat: '昨日の同じ時刻とほぼ同じ' } as const;
---

{
  genres.length > 0 && (
    <ol class="temp">
      {genres.map((genre) => (
        <li class="temp-row">
          <a class="temp-name" href={href(`/category/${genre.category}/`)}>
            <span class="dot" style={`--c:${genre.color}`} />
            {genre.name}
          </a>
          <span class="temp-bar" aria-hidden="true">
            <span style={`width:${genre.heat > 0 ? Math.max(3, Math.round((genre.heat / max) * 100)) : 0}%`} />
          </span>
          <span class="temp-num">
            <b class="num">{genre.topics}</b>
            <small>トピック</small>
          </span>
          <span class:list={['temp-trend', `is-${genre.trend}`]} title={trendText[genre.trend]}>
            {genre.trend !== 'flat' ? <Icon name={genre.trend} size={14} /> : <span aria-hidden="true">―</span>}
            <span class="visually-hidden">{trendText[genre.trend]}</span>
          </span>
        </li>
      ))}
    </ol>
  )
}

<style>
  .temp {
    list-style: none;
    margin: 0;
    padding: 6px 16px 12px;
    display: grid;
    gap: 6px;
  }
  .temp-row {
    display: grid;
    grid-template-columns: 8.6em minmax(0, 1fr) 5.2em 1.2em;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-small);
  }
  .temp-name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .temp-name:hover {
    color: var(--accent);
  }
  .temp-bar {
    height: 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--heat) 10%, var(--surface-2));
    overflow: hidden;
  }
  .temp-bar span {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: var(--heat);
  }
  .temp-num {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .temp-num small {
    margin-left: 2px;
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .temp-trend {
    display: inline-grid;
    place-items: center;
    color: var(--muted);
  }
  .temp-trend.is-up {
    color: var(--heat);
  }
</style>

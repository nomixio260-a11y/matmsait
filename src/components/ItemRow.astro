---
import { faviconUrl, formatDateTime, formatTime, getCategory, href, siteOf } from '../lib/items.ts';
import { popularRank } from '../lib/popular.ts';
import { getSummary, summaryPath } from '../lib/summaries.ts';
import { coverageOf } from '../lib/topics.ts';
import type { Item } from '../lib/types.ts';

interface Props {
  item: Item;
  showCategory?: boolean;
  /** 日付見出しの下では時刻だけ、それ以外は日付も表示する */
  timeOnly?: boolean;
  showExcerpt?: boolean;
}
const { item, showCategory = true, timeOnly = false, showExcerpt = true } = Astro.props;
const site = siteOf(item);
const category = showCategory ? getCategory(item.category) : undefined;
// 日別まとめの記事は保存時の話題度、それ以外はビルド時に数えた話題度
const coverage = Math.max(item.coverage ?? 1, coverageOf(item.id));
// AI 要約がある記事は当サイトの要約ページへ、ない記事は配信元へリンクする
const summary = getSummary(item.id);
const link = summary ? href(summaryPath(item.id)) : item.url;
// 「あとで読む」に保存する内容（ブラウザにだけ保存する）
const saved = JSON.stringify({ id: item.id, title: item.title, url: link, site: site.label, at: item.publishedAt });
// 24時間でよく読まれている記事の順位（上位10件）
const rank = popularRank(item.id);
---

<li
  class="item"
  data-id={item.id}
  data-at={item.publishedAt}
  data-src={item.sourceId}
  data-src-name={site.label}
  data-cat={item.category}
  data-cat-name={getCategory(item.category)?.name}
>
  {
    summary ? (
      <a class="item-title" href={link} data-aid={item.id} data-src={item.sourceId} data-cat={item.category}>
        {item.title}
      </a>
    ) : (
      <a class="item-title" href={link} target="_blank" rel="noopener" data-aid={item.id} data-src={item.sourceId} data-cat={item.category}>
        {item.title}
      </a>
    )
  }
  {
    showExcerpt &&
      (summary ? (
        <p class="item-excerpt item-summary">
          <span class="ai-badge">AI要約</span>
          {summary.summary}
        </p>
      ) : (
        item.excerpt && <p class="item-excerpt">{item.excerpt}</p>
      ))
  }
  <div class="item-meta">
    <span class="item-site">
      <img src={faviconUrl(site.host)} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      {site.source ? <a href={href(`/source/${site.source.id}/`)}>{site.label}</a> : <span>{site.label}</span>}
    </span>
    {
      category && (
        <a class="item-cat" href={href(`/category/${category.slug}/`)}>
          <span class="dot" style={`--c:${category.color}`} />
          {category.name}
        </a>
      )
    }
    <time datetime={item.publishedAt} data-rel>
      {timeOnly ? formatTime(item.publishedAt) : formatDateTime(item.publishedAt)}
    </time>
    {
      coverage >= 2 && (
        <a class="coverage" href={href('/ranking/')} title="この話題を報じた掲載元の数">
          <b>{coverage}</b>社が報道
        </a>
      )
    }
    {
      rank && (
        <a class="pop-badge" href={href('/popular/')} title="24時間でよく読まれている記事の順位">
          人気{rank}位
        </a>
      )
    }
    {summary && !showExcerpt && <span class="ai-badge">AI要約</span>}
    {
      summary && (
        <a class="item-orig" href={item.url} target="_blank" rel="noopener" data-aid={item.id} data-src={item.sourceId} data-cat={item.category}>
          元記事 ↗
        </a>
      )
    }
    <button class="save-btn" type="button" data-save={saved} aria-pressed="false" aria-label="あとで読む" title="あとで読む">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button
      class="more-btn"
      type="button"
      data-item-menu
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label="この記事のメニュー"
      title="フォロー・表示しない・既読"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="5" cy="12" r="1.8" fill="currentColor"></circle>
        <circle cx="12" cy="12" r="1.8" fill="currentColor"></circle>
        <circle cx="19" cy="12" r="1.8" fill="currentColor"></circle>
      </svg>
    </button>
  </div>
</li>

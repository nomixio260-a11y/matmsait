---
/**
 * AI 整理（各メディアの視点）: 共通して報じられていること・各媒体が強調していること・報道内容の差・背景と、
 * AI による整理・解釈（事実とはっきり分ける）。どの項目にも出典の媒体を付ける
 */
import Icon from './Icon.astro';
import { formatDateTime, siteOf } from '../lib/items.ts';
import type { TopicNoteView } from '../lib/topic-notes.ts';

interface Props {
  notes: TopicNoteView;
}
const { notes } = Astro.props;
const { note, common, emphasis, differences, sources, newer } = notes;
const source = (id: string) => {
  const item = sources.get(id);
  return item ? { label: siteOf(item).label, item } : undefined;
};
const sourceIds = new Set([...common, ...differences].flatMap((entry) => entry.sources).concat(emphasis.map((entry) => entry.source)));
---

<div class="notes">
  <p class="notes-meta">
    <span class="ai-badge">AIによる整理</span>
    {formatDateTime(note.notedAt)}時点・{sourceIds.size}媒体の記事から
  </p>

  <h3>共通して報じられていること</h3>
  <ul class="facts">
    {
      common.map((entry) => (
        <li>
          {entry.text}
          <span class="cites">
            {entry.sources.map((id) => {
              const cite = source(id);
              return (
                cite && (
                  <a href={cite.item.url} target="_blank" rel="noopener" data-aid={cite.item.id} data-src={cite.item.sourceId} data-cat={cite.item.category}>
                    {cite.label}
                  </a>
                )
              );
            })}
          </span>
        </li>
      ))
    }
  </ul>

  {
    emphasis.length > 0 && (
      <>
        <h3>各媒体が特に伝えていること</h3>
        <dl class="emphasis">
          {emphasis.map((entry) => {
            const cite = source(entry.source);
            return (
              cite && (
                <div>
                  <dt>
                    <a href={cite.item.url} target="_blank" rel="noopener" data-aid={cite.item.id} data-src={cite.item.sourceId} data-cat={cite.item.category}>
                      {cite.label}
                    </a>
                  </dt>
                  <dd>{entry.text}</dd>
                </div>
              )
            );
          })}
        </dl>
      </>
    )
  }

  {
    differences.length > 0 && (
      <div class="differences" role="note">
        <p class="differences-title">
          <Icon name="info" />
          報道内容に差があります
        </p>
        <ul>
          {differences.map((entry) => (
            <li>
              {entry.text}
              <span class="cites">
                {entry.sources.map((id) => {
                  const cite = source(id);
                  return (
                    cite && (
                      <a href={cite.item.url} target="_blank" rel="noopener" data-aid={cite.item.id} data-src={cite.item.sourceId} data-cat={cite.item.category}>
                        {cite.label}
                      </a>
                    )
                  );
                })}
              </span>
            </li>
          ))}
        </ul>
        <p class="differences-note">どちらが正しいかは判断していません。各媒体の記事で確かめてください。</p>
      </div>
    )
  }

  {
    note.background && (
      <>
        <h3>背景</h3>
        <p class="background">{note.background}</p>
      </>
    )
  }

  {
    note.interpretation && (
      <div class="interpretation">
        <p class="interpretation-title">AIによる整理・解釈<small>（事実ではなく、AI の見方です）</small></p>
        <p>{note.interpretation}</p>
      </div>
    )
  }

  <p class="notes-note">
    運営者がチャット AI に各媒体の記事を読ませて整理し、出典の媒体を確かめて載せています。AI の整理は誤りを含むことがあります。正確な内容は各媒体の記事で確かめてください。
    {newer > 0 && <>整理したあとに{newer}件の報道が加わっています（下の報道タイムライン）。</>}
  </p>
</div>

<style>
  .notes {
    padding: 12px 16px 14px;
  }
  .notes-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  .notes h3 {
    margin: 14px 0 6px;
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 800;
  }
  .notes h3:first-of-type {
    margin-top: 0;
  }
  .facts {
    margin: 0;
    padding-left: 1.2em;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.75;
  }
  .facts li + li {
    margin-top: 4px;
  }
  .cites {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-left: 6px;
    vertical-align: 1px;
  }
  .cites a {
    padding: 0 6px;
    border-radius: 4px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.6;
    text-decoration: none;
    white-space: nowrap;
  }
  .cites a:hover {
    color: var(--accent);
  }
  .emphasis {
    margin: 0;
    display: grid;
    gap: 6px;
    font-size: var(--fs-small);
  }
  .emphasis div {
    display: grid;
    grid-template-columns: minmax(6em, max-content) minmax(0, 1fr);
    gap: 10px;
  }
  .emphasis dt {
    font-weight: 700;
  }
  .emphasis dt a {
    color: var(--text);
    text-decoration: none;
  }
  .emphasis dt a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .emphasis dd {
    margin: 0;
    color: var(--text-2);
    line-height: 1.7;
  }
  @media (max-width: 480px) {
    .emphasis div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  .differences {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--warn-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--warn) 35%, var(--border));
    font-size: var(--fs-small);
  }
  .differences-title {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--warn);
    font-weight: 800;
  }
  .differences ul {
    margin: 6px 0 0;
    padding-left: 1.2em;
    color: var(--text-2);
    line-height: 1.7;
  }
  .differences-note {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  .background {
    margin: 0;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.75;
  }
  .interpretation {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px dashed var(--border-strong);
    font-size: var(--fs-small);
    line-height: 1.75;
  }
  .interpretation p {
    margin: 0;
    color: var(--text-2);
  }
  .interpretation .interpretation-title {
    margin-bottom: 4px;
    color: var(--text);
    font-weight: 800;
  }
  .interpretation-title small {
    margin-left: 4px;
    color: var(--muted);
    font-weight: 400;
  }
  .notes-note {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: var(--fs-caption);
    line-height: 1.7;
  }
</style>

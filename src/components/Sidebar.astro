---
import AdSlot from './AdSlot.astro';
import Icon from './Icon.astro';
import PopularList from './PopularList.astro';
import TopicList from './TopicList.astro';
import { categories, site } from '../config/site.ts';
import { dailyPath, formatDay, getDailySnapshots } from '../lib/daily.ts';
import { countByCategory, getCategory, href } from '../lib/items.ts';
import { getPopular } from '../lib/popular.ts';
import { getHotTopics } from '../lib/topics.ts';

interface Props {
  /** ランキングをこのカテゴリに絞る */
  category?: string;
  /** ランキングを表示しない（ページ本体にランキングがある場合） */
  hideRanking?: boolean;
  /** ランキングを広い画面でだけ表示する（狭い画面ではページ本体側で見せる場合） */
  rankingWideOnly?: boolean;
  /** よく読まれている記事を表示しない（ページ本体にある場合） */
  hidePopular?: boolean;
}
const { category, hideRanking = false, rankingWideOnly = false, hidePopular = false } = Astro.props;
const hours = category ? 72 : 24;
const ranking = hideRanking ? [] : getHotTopics({ hours, category, limit: 8 });
const categoryName = category ? getCategory(category)?.name : undefined;
const counts = countByCategory();
const recentDays = getDailySnapshots().slice(0, 7);
// よく読まれている記事（24時間。まだ少なければ1週間）
const popularDay = hidePopular ? [] : getPopular('day', 5);
const popular = popularDay.length >= 3 || hidePopular ? popularDay : getPopular('week', 5);
const popularWindow = popular === popularDay ? '24時間' : '1週間';
---

<aside class="sidebar stack" aria-label="サイドバー">
  {
    ranking.length > 0 && (
      <section class:list={['panel', { 'wide-only': rankingWideOnly }]}>
        <div class="panel-head">
          <h2>
            <Icon name="heat" class="h-icon is-heat" />
            {categoryName ? `${categoryName}の話題のトピック` : '話題のトピック'}
          </h2>
          <span class="window">{hours}時間</span>
        </div>
        <TopicList topics={ranking} othersLimit={0} />
        <div class="panel-foot">
          <a href={href('/ranking/')}>話題のトピックをもっと見る</a>
        </div>
      </section>
    )
  }

  {
    popular.length > 0 && (
      <section class="panel">
        <div class="panel-head">
          <h2>よく読まれている記事</h2>
          <span class="window">{popularWindow}</span>
        </div>
        <PopularList entries={popular} />
        <div class="panel-foot">
          <a href={href('/popular/')}>人気の記事をもっと見る</a>
        </div>
      </section>
    )
  }

  <section class="panel follow-panel">
    <div class="panel-head">
      <h2>ジャンルをフォロー</h2>
      <a class="more" href={href('/following/')}>フォロー中 →</a>
    </div>
    <div class="follow-body">
      <p>フォローすると、新着を「フォロー中」にまとめます（通知も受け取れます）。</p>
      <div class="chip-row">
        {
          categories.map((c) => (
            <button
              type="button"
              class="chip toggle-chip"
              style={`--c:${c.color}`}
              data-follow={JSON.stringify({ kind: 'cat', value: c.slug, label: c.name })}
              aria-pressed="false"
            >
              <span class="dot" />
              {c.name}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>カテゴリ</h2>
    </div>
    <ul class="cat-list">
      {
        categories.map((c) => (
          <li>
            <a href={href(`/category/${c.slug}/`)} aria-current={c.slug === category ? 'page' : undefined}>
              <span class="dot" style={`--c:${c.color}`} />
              <span class="name">{c.name}</span>
              <span class="count">{counts.get(c.slug) ?? 0}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    recentDays.length > 0 && (
      <section class="panel">
        <div class="panel-head">
          <h2>日別まとめ</h2>
          <a class="more" href={href('/daily/')}>
            一覧 →
          </a>
        </div>
        <ul class="cat-list">
          {recentDays.map((day) => (
            <li>
              <a href={href(dailyPath(day.date))}>
                <span class="name">{formatDay(day.date)}の話題</span>
                <span class="count">{day.total}件</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    site.socialAccounts.length > 0 && (
      <section class="panel">
        <div class="panel-head">
          <h2>最新情報をフォロー</h2>
        </div>
        <ul class="cat-list">
          {site.socialAccounts.map((account) => (
            <li>
              <a href={account.url} target="_blank" rel="noopener me">
                <span class="name">{account.name}</span>
                <span class="count">フォロー ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="sidebar-sticky">
    <AdSlot variant="sidebar" />
  </div>
</aside>

<style>
  .follow-body {
    padding: 12px 16px 14px;
  }
  .follow-body p {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .follow-body .chip {
    min-height: 30px;
    padding: 0 10px;
    font-size: 0.78rem;
  }
  .sidebar {
    min-width: 0;
  }
  .window {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cat-list {
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }
  .cat-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px;
    text-decoration: none;
    font-size: 0.875rem;
  }
  .cat-list a:hover {
    background: var(--surface-2);
  }
  .cat-list a[aria-current='page'] {
    font-weight: 700;
    color: var(--accent);
  }
  .name {
    flex: 1;
  }
  .count {
    color: var(--muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .sidebar-sticky {
    position: sticky;
    top: 62px;
  }
  .sidebar-sticky:empty {
    display: none;
  }
  @media (max-width: 999px) {
    .wide-only {
      display: none;
    }
  }
</style>

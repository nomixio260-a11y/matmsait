---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SUMMARY_LENGTHS } from '../../lib/summary-core.ts';
import { href } from '../../lib/items.ts';
---

<AdminLayout title="AI要約の管理">
  <div class="admin" data-admin data-base={href('')}>
    <div class="intro">
      <h1>AI要約の管理</h1>
      <p>
        要約のない記事を選んでAI用のプロンプトを作り、AIの回答（JSON）を貼り付けて保存すると、サイトの各記事に要約が載ります。
      </p>
      <p class="data-info" id="data-info" aria-live="polite">記事データを読み込んでいます…</p>
    </div>

    <details class="card" id="settings">
      <summary>
        <span class="summary-title">GitHub との連携（保存に必要）</span>
        <span class="badge" id="token-badge">未設定</span>
      </summary>
      <div class="card-body">
        <label class="field">
          <span>GitHub のアクセストークン</span>
          <input id="token" type="password" autocomplete="off" spellcheck="false" placeholder="github_pat_..." />
        </label>
        <label class="check">
          <input id="remember" type="checkbox" />
          このブラウザに記憶する（自分専用の端末でだけ使ってください）
        </label>
        <div class="actions">
          <button type="button" id="test-token">接続を確認</button>
          <button type="button" id="forget-token" class="ghost">トークンを消す</button>
        </div>
        <p class="status" id="token-status" aria-live="polite"></p>
        <div class="help">
          <p>トークンの作り方（最初の1回だけ）:</p>
          <ol>
            <li>
              <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">
                Fine-grained トークンの作成ページ
              </a>
              を開く
            </li>
            <li>「Repository access」で <code id="repo-name">このサイトのリポジトリ</code> だけを選ぶ</li>
            <li>
              「Repository permissions」の <b>Contents</b> を <b>Read and write</b> にして作成（「今すぐ更新」も使う場合は
              <b>Actions</b> も <b>Read and write</b> に）
            </li>
            <li>表示されたトークンを上の欄に貼り付けて「接続を確認」</li>
          </ol>
          <p>トークンはこのブラウザから GitHub に送るだけで、サイトや他の場所には送信・公開されません。</p>
        </div>
      </div>
    </details>

    <section class="card">
      <h2><span class="step" aria-hidden="true">⚡</span>サイトの更新</h2>
      <div class="card-body">
        <p class="note">
          記事の収集とサイトの更新は1時間ごとに自動で行われます。すぐに最新の記事を集めて更新したいときに使います（GitHub Actions
          で動くので費用はかかりません）。
        </p>
        <div class="controls run-controls">
          <button type="button" id="run-update" class="primary">今すぐ更新</button>
        </div>
        <p class="status" id="run-status" aria-live="polite"></p>
        <div class="runs">
          <div class="runs-head">
            <h3>最近の実行</h3>
            <button type="button" id="refresh-runs" class="ghost small">状況を更新</button>
          </div>
          <ul class="run-list" id="run-list">
            <li class="pick-meta">トークンを設定すると表示されます。</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="card">
      <h2><span class="step">1</span>要約する記事を選ぶ</h2>
      <div class="card-body">
        <div class="controls">
          <label class="field inline">
            <span>件数</span>
            <select id="count">
              <option value="10">10件</option>
              <option value="20" selected>20件</option>
              <option value="30">30件</option>
              <option value="50">50件</option>
            </select>
          </label>
          <label class="field inline">
            <span>カテゴリ</span>
            <select id="category"><option value="">すべて</option></select>
          </label>
          <label class="field inline">
            <span>並び順</span>
            <select id="sort">
              <option value="popular">はてブの多い順</option>
              <option value="latest">新しい順</option>
            </select>
          </label>
          <button type="button" id="reselect" class="ghost">上から選び直す</button>
        </div>
        <label class="check">
          <input id="include-summarized" type="checkbox" />
          要約済みの記事も選べるようにする（AI で要約を作り直す）
        </label>
        <p class="counter" id="pick-counter"></p>
        <ul class="pick-list" id="pick-list"></ul>
        <div class="actions">
          <button type="button" id="hide-selected" class="danger small">選んだ記事をサイトから非表示</button>
          <span class="note">広告の規約に触れそうな記事など、載せたくない記事を外せます（あとで戻せます）</span>
        </div>
        <p class="status" id="hide-status" aria-live="polite"></p>
      </div>
    </section>

    <section class="card">
      <h2><span class="step">2</span>プロンプトをコピーしてAIに渡す</h2>
      <div class="card-body">
        <div class="controls">
          <label class="field inline">
            <span>要約の長さ</span>
            <select id="length">
              {
                Object.entries(SUMMARY_LENGTHS).map(([key, value]) => (
                  <option value={key} selected={key === 'normal'}>
                    {value.label}（{value.min}〜{value.max}字）
                  </option>
                ))
              }
            </select>
          </label>
          <label class="check">
            <input id="points" type="checkbox" checked />
            要点（箇条書き）も作る
          </label>
        </div>
        <textarea id="prompt" rows="12" readonly aria-label="AIに渡すプロンプト"></textarea>
        <div class="actions">
          <button type="button" id="copy-prompt" class="primary">プロンプトをコピー</button>
          <button type="button" id="download-prompt">テキストで保存</button>
          <span class="note" id="prompt-info"></span>
        </div>
        <p class="hint">
          プロンプトを丸ごとコピーして、ChatGPT や Gemini など Web ページを読めるチャット AI に貼り付けてください。
          AI は <code>```json</code> のコードブロック1つで回答するよう指示してあるので、そのブロックをコピーして手順3に貼り付けます。
          一度に多いと AI の回答が途中で切れることがあるため、10〜20件ずつがおすすめです。AI が開けなかった記事は「unavailable」として返り、要約待ちに残ります。
        </p>
      </div>
    </section>

    <section class="card">
      <h2><span class="step">3</span>AIの回答（JSON）を貼り付けて確認する</h2>
      <div class="card-body">
        <textarea
          id="response"
          rows="10"
          spellcheck="false"
          aria-label="AIの回答"
          placeholder='[{"id": "...", "status": "ok", "summary": "...", "points": ["..."]}]'></textarea>
        <div class="actions">
          <button type="button" id="check" class="primary">内容を確認する</button>
          <button type="button" id="clear-response" class="ghost">クリア</button>
        </div>
        <div id="check-result" aria-live="polite"></div>
      </div>
    </section>

    <section class="card">
      <h2><span class="step">4</span>保存して公開する</h2>
      <div class="card-body">
        <p class="note" id="save-info">確認できた要約はまだありません。</p>
        <div class="actions">
          <button type="button" id="save" class="primary" disabled>保存して公開</button>
          <button type="button" id="download-json" disabled>保存用JSONをダウンロード</button>
        </div>
        <p class="status" id="save-status" aria-live="polite"></p>
      </div>
    </section>

    <details class="card">
      <summary><span class="summary-title">保存済みの要約</span><span class="badge" id="saved-count">0件</span></summary>
      <div class="card-body">
        <p class="hint">
          「編集」で要約・要点を直接直せます。内容に問題がある要約は、選んで削除できます（削除した記事は要約待ちに戻ります）。
          AI で作り直したいときは、手順1の「要約済みの記事も選べるようにする」を使ってください。
        </p>
        <input id="saved-filter" class="filter" type="search" placeholder="タイトル・要約で絞り込み" aria-label="保存済みの要約を絞り込む" />
        <ul class="pick-list" id="saved-list"></ul>
        <div class="actions">
          <button type="button" id="delete-selected" class="danger" disabled>選んだ要約を削除</button>
        </div>
        <p class="status" id="delete-status" aria-live="polite"></p>
      </div>
    </details>

    <details class="card" id="sources-card">
      <summary>
        <span class="summary-title">収集元の状況</span><span class="badge" id="sources-badge">-</span>
      </summary>
      <div class="card-body">
        <p class="hint">
          直近30日に集めた記事の数と、いちばん新しい記事の日時です。新しい記事が3日以上ない収集元は、フィードの URL
          が変わったか配信が止まっている可能性があります（<code>sources.yaml</code> で修正・削除できます）。
        </p>
        <div class="table-wrap">
          <table class="result-table" id="sources-table"></table>
        </div>
      </div>
    </details>

    <details class="card" id="blocklist-card">
      <summary>
        <span class="summary-title">記事の非表示（NGワード・サイト）</span><span class="badge" id="hidden-count">0件</span>
      </summary>
      <div class="card-body">
        <p class="hint">
          広告の規約に触れそうな記事（成人向け・暴力的な内容など）や、載せたくない記事をサイトから外します。収集は続けるので、条件を消せば元に戻ります。
        </p>
        <div class="block-fields">
          <label class="field">
            <span>NGワード（1行に1つ。見出しに含む記事を非表示）</span>
            <textarea id="block-words" rows="5" spellcheck="false"></textarea>
          </label>
          <label class="field">
            <span>非表示にするサイト（1行に1つ。例: example.com）</span>
            <textarea id="block-hosts" rows="5" spellcheck="false"></textarea>
          </label>
        </div>
        <div class="actions">
          <button type="button" id="save-blocklist" class="primary">保存して反映</button>
        </div>
        <p class="status" id="blocklist-status" aria-live="polite"></p>
        <h3 class="sub">非表示中の記事</h3>
        <ul class="pick-list" id="hidden-list"></ul>
        <div class="actions">
          <button type="button" id="unhide-selected" disabled>選んだ記事を再表示</button>
        </div>
        <p class="status" id="unhide-status" aria-live="polite"></p>
      </div>
    </details>
  </div>
</AdminLayout>

<script>
  import '../../scripts/admin.ts';
</script>

<style>
  .intro h1 {
    margin: 0;
    font-size: 1.4rem;
  }
  .intro p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  :global(.stale-warning) {
    margin: 10px 0 0;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--hot);
    color: var(--hot);
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .admin {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .card > h2,
  .card > summary {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 14px 16px;
    font-size: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .card > summary {
    cursor: pointer;
    font-weight: 700;
  }
  .card:not([open]) > summary {
    border-bottom: 0;
  }
  .summary-title {
    flex: 1;
  }
  .card-body {
    padding: 14px 16px 16px;
  }
  .step {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8rem;
  }
  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted);
  }
  :global(.badge.ok) {
    background: #e7f6ec;
    border-color: #b7e2c4;
    color: #1d6b3a;
  }
  :global(.admin .controls) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 10px 16px;
    margin-bottom: 10px;
  }
  :global(.admin .field) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.8rem;
    color: var(--text-2);
    font-weight: 600;
  }
  :global(.admin .field input) {
    width: 100%;
  }
  :global(.admin .check) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
  }
  :global(.admin input[type='password']),
  :global(.admin select),
  :global(.admin textarea) {
    font: inherit;
    font-size: 0.875rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 8px 10px;
  }
  :global(.admin textarea) {
    width: 100%;
    resize: vertical;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  :global(.admin button) {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  :global(.admin button:hover:not(:disabled)) {
    border-color: var(--accent);
    color: var(--accent);
  }
  :global(.admin button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.admin button.primary) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  :global(.admin button.primary:hover:not(:disabled)) {
    background: var(--accent-strong);
    color: var(--on-accent);
  }
  :global(.admin button.ghost) {
    background: transparent;
  }
  :global(.admin button.danger) {
    color: var(--hot);
    border-color: var(--hot);
  }
  :global(.admin .actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }
  :global(.admin .note),
  :global(.admin .counter),
  :global(.admin .hint) {
    font-size: 0.8rem;
    color: var(--muted);
  }
  :global(.admin .counter) {
    margin: 0 0 8px;
  }
  :global(.admin .hint) {
    margin: 10px 0 0;
  }
  :global(.admin .status) {
    margin: 10px 0 0;
    font-size: 0.85rem;
    font-weight: 600;
  }
  :global(.status.error) {
    color: var(--hot);
  }
  :global(.status.ok) {
    color: #1d6b3a;
  }
  .run-controls {
    margin-top: 10px;
  }
  :global(.admin input.filter) {
    width: 100%;
    margin-bottom: 8px;
    font: inherit;
    font-size: 0.875rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 8px 10px;
  }
  :global(.saved-row) {
    position: relative;
  }
  :global(.saved-row .edit-button) {
    position: absolute;
    top: 8px;
    right: 10px;
  }
  :global(.saved-row label) {
    padding-right: 64px !important;
  }
  :global(.editor) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 4px 12px 12px 36px;
  }
  :global(.editor textarea) {
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.7;
  }
  :global(.editor .field span) {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  :global(.badge-inline) {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .table-wrap {
    overflow-x: auto;
  }
  :global(#sources-table td.num) {
    text-align: right;
    white-space: nowrap;
  }
  :global(#sources-table a) {
    color: var(--text);
  }
  .block-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    margin-top: 10px;
  }
  .sub {
    margin: 16px 0 6px;
    font-size: 0.85rem;
  }
  :global(.pick-reason) {
    grid-column: 2;
    font-size: 0.72rem;
    color: var(--hot);
    font-weight: 700;
  }
  .runs {
    margin-top: 12px;
  }
  .runs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .runs-head h3 {
    margin: 0;
    font-size: 0.85rem;
  }
  :global(.admin button.small) {
    padding: 4px 10px;
    font-size: 0.78rem;
  }
  .run-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  :global(.run-list li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    padding: 8px 12px;
    font-size: 0.8rem;
  }
  :global(.run-list li + li) {
    border-top: 1px solid var(--border);
  }
  :global(.run-list a) {
    color: var(--accent);
    margin-left: auto;
  }
  :global(.run-state) {
    font-weight: 700;
    white-space: nowrap;
  }
  :global(.run-state.ok) {
    color: #1d6b3a;
  }
  :global(.run-state.error) {
    color: var(--hot);
  }
  :global(.run-state.active) {
    color: var(--accent);
  }
  details.help > summary {
    cursor: pointer;
    font-weight: 700;
  }
  .help {
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 0.8rem;
    color: var(--text-2);
  }
  .help p {
    margin: 4px 0;
  }
  .help ol {
    margin: 4px 0;
    padding-left: 1.4em;
  }
  .help a {
    color: var(--accent);
  }
  .pick-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 460px;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  :global(.pick-list li + li) {
    border-top: 1px solid var(--border);
  }
  :global(.pick-list label) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 10px;
    padding: 8px 12px;
    cursor: pointer;
  }
  :global(.pick-list label:hover) {
    background: var(--surface-2);
  }
  :global(.pick-list input) {
    grid-row: span 2;
    margin-top: 4px;
  }
  :global(.pick-title) {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }
  :global(.pick-meta) {
    font-size: 0.72rem;
    color: var(--muted);
  }
  :global(.pick-summary) {
    grid-column: 2;
    font-size: 0.78rem;
    color: var(--text-2);
  }
  :global(.result-summary) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 8px;
  }
  :global(.result-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }
  :global(.result-table th),
  :global(.result-table td) {
    padding: 8px;
    border-top: 1px solid var(--border);
    vertical-align: top;
    text-align: left;
  }
  :global(.result-table th) {
    font-size: 0.72rem;
    color: var(--muted);
    border-top: 0;
  }
  :global(.result-table .points) {
    margin: 4px 0 0;
    padding-left: 1.2em;
    color: var(--text-2);
  }
  :global(.result-state) {
    white-space: nowrap;
    font-weight: 700;
  }
  :global(.result-state.ok) {
    color: #1d6b3a;
  }
  :global(.result-state.skip) {
    color: var(--muted);
  }
  :global(.result-state.error) {
    color: var(--hot);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) .badge.ok) {
      background: #12301d;
      border-color: #1f5a35;
      color: #7ee2a1;
    }
    :global(:root:not([data-theme='light']) .status.ok),
    :global(:root:not([data-theme='light']) .result-state.ok),
    :global(:root:not([data-theme='light']) .run-state.ok) {
      color: #7ee2a1;
    }
  }
  :global(:root[data-theme='dark'] .badge.ok) {
    background: #12301d;
    border-color: #1f5a35;
    color: #7ee2a1;
  }
  :global(:root[data-theme='dark'] .status.ok),
  :global(:root[data-theme='dark'] .result-state.ok),
  :global(:root[data-theme='dark'] .run-state.ok) {
    color: #7ee2a1;
  }
</style>

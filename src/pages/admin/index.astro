---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { href } from '../../lib/items.ts';
---

<AdminLayout title="ホーム" current="overview">
  <noscript><p class="status error">管理画面を使うには JavaScript を有効にしてください。</p></noscript>
  <!-- ログインを確かめるまでは表示しない（admin-dashboard.ts が表示する） -->
  <div class="admin" data-admin data-base={href('')} hidden>
    <div class="intro">
      <h1>ホーム</h1>
      <p class="note" id="data-info" aria-live="polite">読み込んでいます…</p>
    </div>

    <section class="card" aria-labelledby="todo-title">
      <div class="card-head">
        <h2 id="todo-title">対応が必要なこと</h2>
        <span class="badge" id="todo-count">-</span>
      </div>
      <div class="card-body">
        <ul class="todo-list" id="todo-list">
          <li class="info"><span class="todo-text">確認しています…</span></li>
        </ul>
      </div>
    </section>

    <section class="card" aria-labelledby="numbers-title">
      <div class="card-head">
        <h2 id="numbers-title">きょうの数字</h2>
        <a href={href('/admin/analytics/')} id="analytics-link">アクセス解析 →</a>
      </div>
      <div class="card-body">
        <div class="stat-grid" id="stats"></div>
        <p class="note" id="stats-note"></p>
      </div>
    </section>

    <div class="home-grid">
      <section class="card" aria-labelledby="update-title" id="update">
        <div class="card-head">
          <h2 id="update-title">サイトの更新</h2>
          <span class="badge ok" id="token-badge">ログイン中</span>
        </div>
        <div class="card-body">
          <p class="timer-status" id="timer-status" aria-live="polite"></p>
          <div class="actions">
            <button type="button" id="run-update" class="primary">今すぐ更新</button>
            <button type="button" id="test-token" class="ghost small">接続を確認</button>
          </div>
          <p class="status" id="token-status" aria-live="polite"></p>
          <p class="status" id="run-status" aria-live="polite"></p>
          <details class="runs">
            <summary>最近の実行</summary>
            <div class="runs-head">
              <span class="pick-meta">保存先 <code id="repo-name">-</code></span>
              <button type="button" id="refresh-runs" class="ghost small">状況を更新</button>
            </div>
            <ul class="run-list" id="run-list">
              <li class="pick-meta">読み込んでいます…</li>
            </ul>
          </details>
          <details class="help">
            <summary>更新のしくみ</summary>
            <p>記事の収集とサイトの更新は「自動更新タイマー」が約1時間ごとに行います。すぐに最新の記事を集めて更新したいときは「今すぐ更新」を押してください（GitHub Actions で動くので費用はかかりません）。</p>
          </details>
        </div>
      </section>

      <section class="card" aria-labelledby="social-title">
        <div class="card-head">
          <h2 id="social-title">SNS（Bluesky）</h2>
          <a href={href('/admin/social/')}>SNS 投稿 →</a>
        </div>
        <div class="card-body">
          <p class="pick-meta">最近の投稿（30分ごとに自動で投稿）</p>
          <ul class="mini-list" id="social-mini">
            <li class="pick-meta">読み込んでいます…</li>
          </ul>
        </div>
      </section>
    </div>

    <section class="card" aria-labelledby="info-title">
      <div class="card-head"><h2 id="info-title">お知らせ・提案</h2></div>
      <div class="card-body">
        <ul class="todo-list" id="info-list">
          <li class="pick-meta">読み込んでいます…</li>
        </ul>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import '../../scripts/admin-dashboard.ts';
</script>

<style>
  .home-grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .home-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .runs {
    margin-top: 12px;
  }
  .runs > summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .runs .runs-head {
    margin-top: 8px;
  }
  .mini-list {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  .mini-list :global(li) {
    display: grid;
    gap: 2px;
    padding: 8px 0;
    border-top: 1px solid var(--border);
  }
  .mini-list :global(li:first-child) {
    border-top: 0;
  }
  .mini-list :global(.mini-title) {
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }
  .mini-list :global(.mini-title:hover) {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

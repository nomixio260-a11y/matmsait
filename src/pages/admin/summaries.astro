  /* ===== 要約を作る: スマホでも迷わず進めるように（手順の進み具合・下に固定の「次にやること」・畳める一覧・カードの確認結果） ===== */
  .stepper {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stepper button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 8px 4px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .stepper .step {
    width: 20px;
    height: 20px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.72rem;
  }
  .stepper button.done {
    color: var(--text-2);

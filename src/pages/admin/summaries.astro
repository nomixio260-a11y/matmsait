---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ANSWER_FILE_NAME, ARTICLE_TEXT_MAX, SUMMARY_LENGTHS } from '../../lib/summary-core.ts';
import { COPY_ARTICLE_BOOKMARKLET } from '../../lib/bookmarklet.ts';
import { href } from '../../lib/items.ts';
---

<AdminLayout title="AI要約・記事" current="summaries">
  <noscript><p class="status error">管理画面を使うには JavaScript を有効にしてください。</p></noscript>
  <!-- ログインを確かめるまでは表示しない（admin.ts が表示する） -->
  <div class="admin" data-admin data-base={href('')} hidden>
    <div class="intro">
      <h1>AI要約・記事</h1>
      <p class="data-info" id="data-info" aria-live="polite">記事データを読み込んでいます…</p>
    </div>

    <div class="tabs" role="tablist" aria-label="AI要約・記事の作業" data-tabs>
      <button type="button" role="tab" id="tab-make" data-tab="make" aria-controls="panel-make">要約を作る</button>
      <button type="button" role="tab" id="tab-auto" data-tab="auto" aria-controls="panel-auto">自動要約 <span class="badge" id="auto-badge">-</span></button>
      <button type="button" role="tab" id="tab-saved" data-tab="saved" aria-controls="panel-saved">保存済み <span class="badge" id="saved-count">0件</span></button>
      <button type="button" role="tab" id="tab-hide" data-tab="hide" aria-controls="panel-hide">記事の非表示 <span class="badge" id="hidden-count">0件</span></button>
      <button type="button" role="tab" id="tab-sources" data-tab="sources" aria-controls="panel-sources">収集元 <span class="badge" id="sources-badge">-</span></button>
    </div>

    <div class="tab-panel" role="tabpanel" id="panel-make" data-panel="make" aria-labelledby="tab-make">
    <!-- 手順の進み具合（いまの手順を強調。押すとその手順へ移る） -->
    <ol class="stepper" id="stepper" aria-label="要約を作る手順">
      <li><button type="button" data-step="1"><span class="step">1</span>選ぶ</button></li>
      <li><button type="button" data-step="2"><span class="step">2</span>コピー</button></li>
      <li><button type="button" data-step="3"><span class="step">3</span>貼り付け</button></li>
      <li><button type="button" data-step="4"><span class="step">4</span>保存</button></li>
    </ol>

    <section class="card" id="step-1">
      <h2><span class="step">1</span>要約する記事を選ぶ</h2>
      <div class="card-body">
        <div class="controls pick-controls">
          <label class="field inline">
            <span>件数</span>
            <select id="count">
              <option value="10">10件</option>
              <option value="20" selected>20件</option>
              <option value="30">30件</option>
              <option value="50">50件</option>
            </select>
          </label>
          <label class="field inline">
            <span>カテゴリ</span>
            <select id="category"><option value="">すべて</option></select>
          </label>
          <label class="field inline sort-field">
            <span>並び順</span>
            <select id="sort">
              <option value="popular">話題の順（報じたサイトが多い順）</option>
              <option value="read" hidden disabled>よく読まれている順（アクセス解析）</option>
              <option value="latest">新しい順</option>
            </select>
          </label>
        </div>
        <div class="pick-head">
          <p class="counter" id="pick-counter"></p>
          <button type="button" id="reselect" class="ghost small">上から選び直す</button>
        </div>
        <!-- 選んだ記事の一覧（スマホでは畳んでおき、見たいときだけ開く） -->
        <details class="pick-details" id="pick-details" open>
          <summary id="pick-details-label">選んだ記事を見る・変える</summary>
          <label class="check">
            <input id="include-summarized" type="checkbox" />
            <span>要約済みの記事も選べるようにする（AI で要約を作り直す）</span>
          </label>
          <ul class="pick-list" id="pick-list"></ul>
          <div class="actions">
            <button type="button" id="hide-selected" class="danger small">選んだ記事をサイトから非表示</button>
            <span class="note">広告の規約に触れそうな記事など、載せたくない記事を外せます（あとで戻せます）</span>
          </div>
          <p class="status" id="hide-status" aria-live="polite"></p>
        </details>
      </div>
    </section>

    <section class="card" id="step-2">
      <h2><span class="step">2</span>プロンプトをコピーしてAIに渡す</h2>
      <div class="card-body">
        <div class="prompt-parts" id="prompt-parts" hidden></div>
        <div class="actions copy-actions">
          <button type="button" id="copy-prompt" class="primary">プロンプトをコピー</button>
          <button type="button" id="download-prompt">ファイルで保存</button>
          <button type="button" id="download-prompt-all" hidden>全部を1つのファイルで保存</button>
        </div>
        <p class="note" id="prompt-info"></p>
        <div class="status" id="prompt-status" aria-live="polite"></div>
        <details class="sub-details" id="prompt-settings">
          <summary>設定: <span id="prompt-settings-text"></span></summary>
          <div class="controls">
            <label class="field inline">
              <span>要約の長さ</span>
              <select id="length">
                {
                  Object.entries(SUMMARY_LENGTHS).map(([key, value]) => (
                    <option value={key} selected={key === 'normal'}>
                      {value.label}（{value.min}〜{value.max}字）
                    </option>
                  ))
                }
              </select>
            </label>
            <label class="field inline">
              <span>1回に貼り付ける長さの上限</span>
              <select id="max-chars">
                <option value="0">上限なし</option>
                <option value="8000">8,000字</option>
                <option value="15000" selected>15,000字</option>
                <option value="30000">30,000字</option>
                <option value="60000">60,000字</option>
              </select>
            </label>
            <label class="field inline">
              <span>AI の回答のしかた</span>
              <select id="answer-mode">
                <option value="codeblock" selected>コードブロック（コピー）</option>
                <option value="file">JSON ファイル（ダウンロード）</option>
              </select>
            </label>
            <label class="check">
              <input id="points" type="checkbox" checked />
              <span>要点（箇条書き）も作る</span>
            </label>
          </div>
        </details>
        <details class="sub-details" id="prompt-view">
          <summary>プロンプトの中身を見る</summary>
          <textarea id="prompt" rows="12" readonly aria-label="AIに渡すプロンプト"></textarea>
        </details>
        <details class="help">
          <summary>プロンプトの渡し方</summary>
          <ul>
            <li>プロンプトを丸ごとコピーして、ChatGPT や Gemini など Web ページを読めるチャット AI に貼り付けます。AI は <code>```json</code> のコードブロック1つで答えるので、そのブロックをコピーして手順3に貼り付けます。</li>
            <li>貼り付けられる長さには上限があるので、上限を超えるプロンプトは何回かに分けます（1回ずつ渡して、回答をそれぞれ確認・保存します）。貼り付けられないときは「ファイルで保存」して、AI にファイルとして添付できます。</li>
            <li>「AI の回答のしかた」を「JSON ファイル」にすると、AI に {ANSWER_FILE_NAME} を作ってもらい、手順3で読み込めます（ファイルを作れる AI で使えます）。</li>
            <li>一度に多いと AI の回答が途中で切れることがあるため、10〜20件ずつがおすすめです。AI が開けなかった記事は「unavailable」として返り、「AI が開けない記事」に移ります。</li>
          </ul>
        </details>
      </div>
    </section>

    <section class="card" id="step-3">
      <h2><span class="step">3</span>AIの回答（JSON）を貼り付けて確認する</h2>
      <div class="card-body">
        <div class="actions">
          <button type="button" id="paste-check" class="primary">回答を貼り付けて確認</button>
        </div>
        <p class="note">AI の回答（<code>```json</code> から <code>```</code> まで）をコピーしてから押すと、貼り付けて確認まで行います。下の欄に貼り付けても、すぐに確認します。</p>
        <textarea
          id="response"
          rows="6"
          spellcheck="false"
          aria-label="AIの回答"
          placeholder='[{"id": "...", "status": "ok", "summary": "...", "points": ["..."]}]'></textarea>
        <div class="actions">
          <button type="button" id="check">内容を確認する</button>
          <button type="button" id="response-file-button">ファイルから読み込む</button>
          <input type="file" id="response-file" accept=".json,.txt,.md,application/json,text/plain" multiple hidden />
          <button type="button" id="clear-response" class="ghost">クリア</button>
        </div>
        <p class="note">AI が作った JSON ファイル（{ANSWER_FILE_NAME}）・回答を保存したファイル・「保存用JSON」も読み込めます（この欄へのドラッグでも可）。</p>
        <p class="status" id="response-file-status" aria-live="polite"></p>
        <div id="check-result" aria-live="polite"></div>
      </div>
    </section>

    <section class="card" id="step-4">
      <h2><span class="step">4</span>保存して公開する</h2>
      <div class="card-body">
        <p class="note" id="save-info">確認できた要約はまだありません。</p>
        <div class="actions">
          <button type="button" id="save" class="primary" disabled>保存して公開</button>
          <button type="button" id="download-json" disabled>保存用JSONをダウンロード</button>
        </div>
        <p class="status" id="save-status" aria-live="polite"></p>
      </div>
    </section>

    <details class="card" id="paste-card">
      <summary>
        <span class="summary-title">AI が開けない記事（本文を貼り付けて要約）</span><span class="badge" id="paste-count">0件</span>
      </summary>
      <div class="card-body">
        <p class="hint">AI が開けなかった記事は、本文を貼り付けると、本文入りのプロンプトで要約を頼めます（いちばん下にプロンプトができます）。</p>
        <details class="help">
          <summary>使い方</summary>
          <ul>
            <li>サイトのボット対策などで AI が記事を開けず「unavailable」になった記事が、ここに集まります。</li>
            <li>自分のブラウザで記事を開いて本文をコピーし、ここに貼り付けると、いちばん下に<b>本文入りのプロンプト</b>ができます。それをコピー（またはファイルで保存）して AI に渡すと、AI は URL を開かずに本文から要約の JSON を書きます。回答は手順3で確認・保存します。</li>
            <li>同じ話題を別のサイトも報じていれば、そちらの記事に切り替えることもできます。</li>
            <li>貼り付けた本文はこのタブの中でプロンプトを作るのに使うだけで、サイトや GitHub には保存・公開しません（タブを閉じると消えます）。本文は1記事{ARTICLE_TEXT_MAX.toLocaleString()}字までを使います。</li>
            <li><b>本文の自動取得:</b> 自動収集（約1時間ごと・依頼した直後にも実行）が本文を取りに行き、取得できた本文がここに入ります（数分かかります）。robots.txt で断っているサイト、AI での利用を断っているサイト（robots.txt・noai）、アクセスを拒否したサイトからは取得しません。取得した本文は、管理画面にログインした人だけが読めるよう暗号化して保存し、公開しません。</li>
          </ul>
        </details>
        <div class="auto-text">
          <div class="actions">
            <button type="button" id="request-texts" class="small">一覧の記事の本文を自動で取得する</button>
            <span class="note" id="auto-text-status" aria-live="polite"></span>
          </div>
        </div>
        <div class="bookmarklet-row">
          <a class="bookmarklet" id="bookmarklet" href={COPY_ARTICLE_BOOKMARKLET} draggable="true">本文をコピー（トピあつめ）</a>
          <span class="note">
            このボタンをブックマークバーにドラッグして登録しておくと、記事のページで押すだけで本文をコピーできます。うまく取れないときは、本文を選んでから押すか、本文を選んでコピーしてください。
          </span>
        </div>
        <div class="bulk-paste">
          <label class="field" for="bulk-text">本文をまとめて貼り付け（ページの URL で記事に自動で振り分けます）</label>
          <textarea
            id="bulk-text"
            rows="3"
            spellcheck="false"
            placeholder="「本文をコピー」でコピーした本文をここに貼り付けます（いくつ続けて貼ってもかまいません）"></textarea>
          <div class="actions">
            <button type="button" id="bulk-assign" class="small">振り分ける</button>
            <button type="button" id="text-file-button" class="small">本文のファイルを読み込む</button>
            <input type="file" id="text-file" accept=".txt,.md,text/plain" multiple hidden />
            <span class="note">「本文をコピー」の「ファイルで保存」で保存した本文を、まとめて読み込めます（この欄にドラッグしても読み込めます）。</span>
          </div>
        </div>
        <p class="note" id="paste-flagged" hidden></p>
        <ul class="paste-list" id="paste-list"></ul>
        <p class="status" id="paste-status" aria-live="polite"></p>
        <div class="prompt-panel" id="paste-prompt-panel" hidden>
          <h3>本文入りのプロンプト（本文を貼った記事の要約を AI に依頼する）</h3>
          <div class="prompt-parts" id="paste-prompt-parts" hidden></div>
          <textarea id="paste-prompt" rows="8" readonly aria-label="本文入りのプロンプト"></textarea>
          <div class="actions">
            <button type="button" id="paste-prompt-copy" class="primary">プロンプトをコピー</button>
            <button type="button" id="paste-prompt-download">ファイルで保存</button>
            <button type="button" id="paste-prompt-download-all" hidden>全部を1つのファイルで保存</button>
            <span class="note" id="paste-prompt-info"></span>
          </div>
          <div class="status" id="paste-prompt-status" aria-live="polite"></div>
        </div>
      </div>
    </details>

    <!-- 次にやること（画面の下に固定。スマホでも、スクロールせずに親指で押せるように） -->
    <div class="flow-bar" id="flow-bar" hidden>
      <p class="flow-text" id="flow-text" aria-live="polite"></p>
      <button type="button" class="primary" id="flow-action"></button>
    </div>
    </div>

    <div class="tab-panel" role="tabpanel" id="panel-auto" data-panel="auto" data-aliases="auto-card" aria-labelledby="tab-auto" hidden>
    <section class="card" id="auto-card">
      <div class="card-head"><h2>AI の自動要約</h2></div>
      <div class="card-body">
        <ul class="auto-status" id="auto-status"></ul>
        <details class="help">
          <summary>自動要約のしくみ</summary>
          <p>
          毎時の更新のたびに、要約のない記事（多くの媒体が報じたトピックの記事を優先）を、Cloudflare Workers AI の無料枠（1日1万ニューロン）の中で AI（既定は Qwen3.8 27B を考える量 xhigh で）が記事の本文をもとに自動で要約し、保存します。考える量が多いほど要約はよくなりますが、使う量が増えるので1日の件数は少なくなります（xhigh で1日3件前後。使う量は1日の時間で均します）。本文を取得できない記事（robots.txt や AI での利用を断っているサイトなど）は要約しません。要約の決まりに合わない回答（推測・宣伝の言葉・中身のない定型文・見出しと関係のない内容など）は1回だけ直させ、それでも直らなければ保存しません。自動で作った要約は、下の「保存済みの要約」に「自動」と表示されるので、記事と見比べて必要なら編集・作り直し・削除をしてください（編集すると、サイトの「自動で作成」の表示が消えます）。止めるときは GitHub の変数 <code>AUTO_SUMMARY_PER_RUN</code> を <code>0</code> に、考える量は <code>AUTO_SUMMARY_REASONING</code>（off・low・medium・xhigh）、モデルは <code>AUTO_SUMMARY_MODEL</code> で変えられます（README の「AI の自動要約」）。</p>
        </details>
      </div>
    </section>
    </div>

    <div class="tab-panel" role="tabpanel" id="panel-saved" data-panel="saved" data-aliases="saved-card" aria-labelledby="tab-saved" hidden>
    <section class="card" id="saved-card">
      <div class="card-head"><h2>保存済みの要約</h2></div>
      <div class="card-body">
        <p class="hint">「編集」で直接直せます。問題のある要約は選んで削除できます（削除した記事は要約待ちに戻ります）。</p>
        <details class="help">
          <summary>使い方</summary>
          <ul>
            <li>AI で作り直したいときは、「要約を作る」の手順1の「要約済みの記事も選べるようにする」を使います。</li>
            <li>「要確認」は、要約の決まり（見出しの言い換え・宣伝の言葉・中身のない定型文・推測・あいまいな日付・文体・長すぎる文など）に合っていない可能性がある点を機械的に見つけたものです。記事と見比べて、必要なら編集か作り直しをします。</li>
            <li>「自動」は AI が自動で作った要約です。編集すると、サイトの「自動で作成」の表示が消えます。</li>
          </ul>
        </details>
        <input id="saved-filter" class="filter" type="search" placeholder="タイトル・要約で絞り込み" aria-label="保存済みの要約を絞り込む" />
        <div class="filter-row">
          <label class="check">
            <input id="saved-warn-only" type="checkbox" />
            <span>要確認だけ表示（<span id="saved-warn-count">0</span>件）</span>
          </label>
          <label class="check">
            <input id="saved-auto-only" type="checkbox" />
            <span>AI が自動で作り、まだ手直ししていないものだけ表示（<span id="saved-auto-count">0</span>件）</span>
          </label>
        </div>
        <ul class="pick-list" id="saved-list"></ul>
        <div class="actions">
          <button type="button" id="delete-selected" class="danger" disabled>選んだ要約を削除</button>
        </div>
        <p class="status" id="delete-status" aria-live="polite"></p>
      </div>
    </section>
    </div>

    <div class="tab-panel" role="tabpanel" id="panel-hide" data-panel="hide" data-aliases="blocklist-card" aria-labelledby="tab-hide" hidden>
    <section class="card" id="blocklist-card">
      <div class="card-head"><h2>記事の非表示（NGワード・サイト）</h2></div>
      <div class="card-body">
        <p class="hint">広告の規約に触れそうな記事や、載せたくない記事をサイトから外します。収集は続けるので、条件を消せば元に戻ります。</p>
        <div class="block-fields">
          <label class="field">
            <span>NGワード（1行に1つ。見出しに含む記事を非表示）</span>
            <textarea id="block-words" rows="5" spellcheck="false"></textarea>
          </label>
          <label class="field">
            <span>非表示にするサイト（1行に1つ。例: example.com）</span>
            <textarea id="block-hosts" rows="5" spellcheck="false"></textarea>
          </label>
        </div>
        <div class="actions">
          <button type="button" id="save-blocklist" class="primary">保存して反映</button>
        </div>
        <p class="status" id="blocklist-status" aria-live="polite"></p>
        <h3 class="sub">非表示中の記事</h3>
        <ul class="pick-list" id="hidden-list"></ul>
        <div class="actions">
          <button type="button" id="unhide-selected" disabled>選んだ記事を再表示</button>
        </div>
        <p class="status" id="unhide-status" aria-live="polite"></p>
      </div>
    </section>
    </div>

    <div class="tab-panel" role="tabpanel" id="panel-sources" data-panel="sources" data-aliases="sources-card" aria-labelledby="tab-sources" hidden>
    <section class="card" id="sources-card">
      <div class="card-head"><h2>収集元の状況</h2></div>
      <div class="card-body">
        <p class="hint">取得の失敗が3回以上続いている収集元や、新しい記事が3日以上ない収集元は、フィードの URL が変わったか配信が止まっている可能性があります（<code>sources.yaml</code> で修正・削除できます）。</p>
        <label class="check sources-toggle">
          <input id="sources-all" type="checkbox" />
          <span>正常な収集元も表示（<span id="sources-ok-count">0</span>件）</span>
        </label>
        <p class="status ok" id="sources-empty" hidden>確認が必要な収集元はありません。</p>
        <div class="table-wrap">
          <table class="result-table" id="sources-table"></table>
        </div>
      </div>
    </section>
    </div>
  </div>
</AdminLayout>

<script>
  import '../../scripts/admin.ts';
</script>

<style>
  .intro h1 {
    margin: 0;
    font-size: 1.4rem;
  }
  .intro p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  :global(.stale-warning) {
    margin: 10px 0 0;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--hot);
    color: var(--hot);
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .admin {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .admin[hidden] {
    display: none;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .card > h2,
  .card > summary {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 14px 16px;
    font-size: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .card > summary {
    cursor: pointer;
    font-weight: 700;

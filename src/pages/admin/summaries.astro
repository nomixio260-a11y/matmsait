  /* 終わった手順は番号の代わりに ✓ */
  .stepper button.done .step {
    border-color: var(--accent);
    color: transparent;
    position: relative;
  }
  .stepper button.done .step::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent-strong);
    font-size: 0.75rem;
  }
  .stepper button[aria-current='step'] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .stepper button[aria-current='step'] .step {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemList from '../../components/ItemList.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { site } from '../../config/site.ts';
import { faviconUrl, formatDateTime, getCategory, getItemsByCategory, href, siteOf } from '../../lib/items.ts';
import { getRelatedIndex, topicOf } from '../../lib/topics.ts';
import { clampDescription } from '../../lib/seo.ts';
import { getSummaries, summaryPath } from '../../lib/summaries.ts';
import type { SummaryRecord } from '../../lib/types.ts';

export const getStaticPaths = (() =>
  getSummaries().map((record) => ({ params: { id: record.id }, props: { record } }))) satisfies GetStaticPaths;

interface Props {
  record: SummaryRecord;
}
const { record } = Astro.props;
const category = getCategory(record.category);
const source = siteOf(record);
const url = new URL(href(summaryPath(record.id)), Astro.site).toString();
// 同じ話題を報じたほかの掲載元の記事（話題のまとまりにあればそれを、なければ見出しの似た記事）
const topic = topicOf(record.id);
const coverage = topic?.coverage ?? 1;
const fromTopic = topic ? topic.items.filter((item) => item.id !== record.id).slice(0, 8) : [];
const sameTopic = fromTopic.length > 0 ? fromTopic : getRelatedIndex().related(record, 5);
// 関連する要約: キーワードが共通する要約を先に、足りなければ同じカテゴリの新しい要約
const keywordSet = new Set((record.keywords ?? []).map((keyword) => keyword.normalize('NFKC').toLowerCase()));
const sharedKeywords = (other: SummaryRecord) =>
  (other.keywords ?? []).filter((keyword) => keywordSet.has(keyword.normalize('NFKC').toLowerCase())).length;
const sameTopicIds = new Set(sameTopic.map((item) => item.id));
const candidates = getSummaries().filter((other) => other.id !== record.id && !sameTopicIds.has(other.id));
const byKeyword = candidates
  .map((other) => ({ other, shared: sharedKeywords(other) }))
  .filter(({ shared }) => shared > 0)
  .sort((a, b) => b.shared - a.shared || b.other.summarizedAt.localeCompare(a.other.summarizedAt))
  .map(({ other }) => other);
const relatedSummaries = [
  ...byKeyword,
  ...candidates.filter((other) => other.category === record.category && !byKeyword.includes(other)),
].slice(0, 5);
const relatedIds = new Set([record.id, ...sameTopic.map((item) => item.id), ...relatedSummaries.map((other) => other.id)]);
const latestInCategory = getItemsByCategory(record.category)
  .filter((item) => !relatedIds.has(item.id))
  .slice(0, 6);

const description = clampDescription(record.summary);
const home = new URL(href('/'), Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: Array.from(record.title).slice(0, 110).join(''),
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: 'ja',
    datePublished: record.summarizedAt,
    dateModified: record.updatedAt ?? record.summarizedAt,
    isBasedOn: record.url,
    ...(record.keywords?.length ? { keywords: record.keywords.join(', ') } : {}),
    image: new URL(href('/og.png'), Astro.site).toString(),
    author: { '@type': 'Organization', name: site.name, url: home },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      logo: { '@type': 'ImageObject', url: new URL(href('/icon-512.png'), Astro.site).toString() },
    },
  },
];
const shortTitle = Array.from(record.title).length > 30 ? `${Array.from(record.title).slice(0, 29).join('')}…` : record.title;
---

<BaseLayout
  title={`${record.title}【要約】`}
  description={description}
  current={record.category}
  jsonLd={jsonLd}
  breadcrumbs={[
    ...(category ? [{ name: category.name, path: `/category/${category.slug}/` }] : []),
    { name: shortTitle },
  ]}
>
  <article
    class="stack"
    data-article-view
    data-aid={record.id}
    data-src={record.sourceId}
    data-cat={record.category}
    data-title={record.title}
    data-url={record.url}
  >
    <header class="article-head">
      <p class="kicker">
        {
          category && (
            <a href={href(`/category/${category.slug}/`)}>
              <span class="dot" style={`--c:${category.color}`} />
              {category.name}
            </a>
          )
        }
        <span class="source">
          <img src={faviconUrl(source.host)} alt="" width="16" height="16" referrerpolicy="no-referrer" />
          {source.label}
        </span>
        <time datetime={record.publishedAt}>{formatDateTime(record.publishedAt)}</time>
        {
          coverage >= 2 && (
            <a class="coverage" href={href('/ranking/')} title="この話題を報じた掲載元の数">
              <b>{coverage}</b>社が報道
            </a>
          )
        }
      </p>
      <h1>{record.title}</h1>
    </header>

    <section class="panel ai-box" aria-labelledby="ai-summary-title">
      <h2 id="ai-summary-title"><span class="ai-badge">AI要約</span>この記事の要約</h2>
      <p class="summary-text">{record.summary}</p>
      {
        record.points.length > 0 && (
          <ul class="points">
            {record.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        )
      }
      {
        record.background && (
          <div class="background">
            <h3>背景・用語</h3>
            <p>{record.background}</p>
          </div>
        )
      }
      {
        record.keywords && record.keywords.length > 0 && (
          <div class="keywords">
            <h3 class="visually-hidden">キーワード</h3>
            <ul>
              {record.keywords.map((keyword) => (
                <li>
                  <a href={`${href('/search/')}?q=${encodeURIComponent(keyword)}`}>#{keyword}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p class="ai-note">
        この要約はAIが元記事をもとに作成し、運営者が確認して掲載しています。正確な内容や詳細は元記事でご確認ください。要約の作り方は<a href={href('/editorial/')}>編集方針</a>をご覧ください。
      </p>
      <a class="read-original" href={record.url} target="_blank" rel="noopener" data-aid={record.id} data-src={record.sourceId} data-cat={record.category}>
        元記事を読む（{source.label}）↗
      </a>
    </section>

    <ShareButtons url={url} text={`${record.title}【要約】｜${site.name}`} />

    {
      sameTopic.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h2>{fromTopic.length > 0 ? 'この話題を報じたほかのメディア' : 'この話題の関連記事'}</h2>
          </div>
          <ItemList items={sameTopic} group={false} showExcerpt={false} ads={false} />
        </section>
      )
    }

    {
      relatedSummaries.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h2>{byKeyword.length > 0 ? '関連するAI要約' : `${category?.name ?? 'このカテゴリ'}のAI要約`}</h2>
            <a class="more" href={href('/summaries/')}>
              一覧 →
            </a>
          </div>
          <ItemList items={relatedSummaries} group={false} showCategory={false} ads={false} />
        </section>
      )
    }

    {
      latestInCategory.length > 0 && category && (
        <section class="panel">
          <div class="panel-head">
            <h2>{category.name}の新着</h2>
            <a class="more" href={href(`/category/${category.slug}/`)}>
              もっと見る →
            </a>
          </div>
          <ItemList items={latestInCategory} group={false} showCategory={false} showExcerpt={false} ads={false} />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .article-head h1 {
    margin: 6px 0 0;
    font-size: 1.4rem;
    line-height: 1.5;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .kicker a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-weight: 700;
    text-decoration: none;
  }
  .kicker a:hover {
    text-decoration: underline;
  }
  .source {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--text-2);
  }
  .source img {
    width: 14px;
    height: 14px;
    border-radius: 3px;
  }
  .ai-box {
    padding: 18px 20px 20px;
  }
  .ai-box h2 {
    margin: 0 0 10px;
    font-size: 1rem;
  }
  .summary-text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.9;
  }
  .points {
    margin: 14px 0 0;
    padding: 12px 14px 12px 32px;
    border-radius: 10px;
    background: var(--surface-2);
    line-height: 1.8;
  }
  .background {
    margin: 14px 0 0;
    padding: 12px 14px;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--accent-soft);
  }
  .background h3 {
    margin: 0 0 4px;
    font-size: 0.8rem;
    color: var(--accent-strong);
  }
  .background p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .keywords ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .keywords a {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .keywords a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .ai-note {
    margin: 14px 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .ai-note a {
    color: var(--accent);
  }
  .read-original {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    min-height: 48px;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }
  .read-original:hover {
    background: var(--accent-strong);
  }
</style>

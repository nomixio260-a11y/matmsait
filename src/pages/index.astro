---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemList from '../components/ItemList.astro';
import PickList from '../components/PickList.astro';
import PopularList from '../components/PopularList.astro';
import SummaryCard from '../components/SummaryCard.astro';
import TopicList from '../components/TopicList.astro';
import { categories, site } from '../config/site.ts';
import { getPicks } from '../lib/editorial.ts';
import { builtAt, formatDateTime, getItems, getItemsByCategory, getSources, href, pickVaried } from '../lib/items.ts';
import { getPopular } from '../lib/popular.ts';
import { clampDescription, headlineTeaser } from '../lib/seo.ts';
import { getSummaries } from '../lib/summaries.ts';
import { getHotTopics } from '../lib/topics.ts';

// 収集元が多く、更新の多いサイトが続くと他が埋もれるため、同じ掲載元は数件までにして新着順に並べる
const latest = pickVaried(getItems(), 30, 3);
const summaries = getSummaries().slice(0, 6);
const hot = getHotTopics({ hours: 24, limit: 6 });
// よく読まれている記事（24時間。まだ少なければ1週間）
const popularDay = getPopular('day', 5);
const popular = popularDay.length >= 3 ? popularDay : getPopular('week', 5);
const sections = categories
  .map((category) => ({ category, items: pickVaried(getItemsByCategory(category.slug), 6, 2) }))
  .filter((section) => section.items.length > 0);
const sourceCount = getSources().length;
// 編集部のピックアップ（管理画面で選んだ記事と、運営者のひとこと）
const picks = getPicks();

const description = clampDescription(
  hot.length > 0
    ? `${sourceCount}の人気ニュースサイトの新着記事を1時間ごとにまとめてお届け。いま話題：${headlineTeaser(
        hot.map((topic) => topic.lead),
        2,
        22,
      )}`
    : site.description,
);
const home = new URL(href('/'), Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: home,
    logo: new URL(href('/icon-512.png'), Astro.site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: home,
    description: site.description,
    inLanguage: 'ja',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${new URL(href('/search/'), Astro.site)}?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout current="" description={description} jsonLd={jsonLd} sidebar={{ hideRanking: true, hidePopular: true }}>
  <div class="stack">
    <section class="intro">
      <h1>{site.seoTitle}</h1>
      <p>
        {site.name}は、{sourceCount}の人気ニュースサイトの新着記事を1時間ごとに自動で集め、多くのメディアが報じた話題とAI要約でポイントをまとめています。
        <span class="updated">最終更新 {formatDateTime(builtAt)}</span>
        <span class="live-count" data-live-count hidden></span>
      </p>
      <p class="since" data-since-banner hidden></p>
    </section>

    {
      picks.length > 0 && (
        <section class="panel" aria-labelledby="picks-title">
          <div class="panel-head">
            <h2 id="picks-title">編集部のピックアップ</h2>
          </div>
          <PickList picks={picks} />
        </section>
      )
    }

    {
      hot.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h2>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="flame">
                <path
                  d="M12 2c1 3.5 5 6 5 11a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.7 1.2 2.7 2.3 3C10.6 8 11.3 5 12 2Z"
                  fill="currentColor"
                />
              </svg>
              いま話題のニュース
            </h2>
            <a class="more" href={href('/ranking/')}>
              すべて見る →
            </a>
          </div>
          <TopicList topics={hot} />
        </section>
      )
    }

    {
      popular.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h2>よく読まれている記事</h2>
            <a class="more" href={href('/popular/')}>
              すべて見る →
            </a>
          </div>
          <PopularList entries={popular} />
        </section>
      )
    }

    {
      summaries.length > 0 && (
        <section class="summaries" aria-labelledby="summaries-title">
          <div class="section-head">
            <h2 id="summaries-title">
              <span class="ai-badge">AI要約</span>
              ニュースのポイント
            </h2>
            <a class="more" href={href('/summaries/')}>
              もっと見る →
            </a>
          </div>
          <div class="card-grid">
            {summaries.map((record) => (
              <SummaryCard record={record} />
            ))}
          </div>
        </section>
      )
    }

    <section class="panel">
      <div class="panel-head">
        <h2>新着記事</h2>
        <a class="more" href={href('/latest/')}>すべて見る →</a>
      </div>
      <ItemList items={latest} headingLevel={3} />
      <div class="panel-foot">
        <a href={href('/latest/')}>新着記事をもっと見る</a>
      </div>
    </section>

    <div class="cat-grid">
      {
        sections.map(({ category, items }) => (
          <section class="panel cat-panel" style={`--c:${category.color}`}>
            <div class="panel-head">
              <h2>
                <span class="dot" />
                {category.name}
              </h2>
              <a class="more" href={href(`/category/${category.slug}/`)}>
                もっと見る →
              </a>
            </div>
            <ItemList items={items} group={false} showCategory={false} showExcerpt={false} ads={false} />
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .intro h1 {
    margin: 0;
    font-size: 1.15rem;
  }
  .intro p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .updated {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .since {
    display: inline-block;
    margin-top: 10px !important;
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--focus) 12%, var(--surface));
    color: var(--text) !important;
    font-weight: 600;
  }
  .since[hidden] {
    display: none;
  }
  .flame {
    color: var(--hot);
  }
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .section-head h2 {
    margin: 0;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .section-head .more {
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .section-head .more:hover {
    text-decoration: underline;
  }
  /* スマートフォンでは横にスクロールして読む（縦に長くなりすぎないように） */
  .card-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 6px;
  }
  .card-grid > :global(*) {
    scroll-snap-align: start;
  }
  @media (min-width: 620px) {
    .card-grid {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
      padding-bottom: 0;
    }
  }
  @media (min-width: 1000px) {
    .card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cat-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 720px) {
    .cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* カテゴリの色を見出しの上に細く入れる */
  .cat-panel {
    border-top: 3px solid var(--c);
  }
  .cat-panel .dot {
    background: var(--c);
  }
</style>

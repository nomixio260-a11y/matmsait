---
/**
 * トップ: 今日のダッシュボード。「今日なにが起きている？」→「急に何が起きた？」→「今日なにを知ればいい？」→「何が変わった？」の順に。
 * 記事の一覧ではなく、トピック（同じ出来事を報じた記事のまとまり）と変化を先に見せる。
 * AI ニュース・10秒でわかるニュース・メディア別・カテゴリ別は、それぞれのページ（ジャンルから辿れる）に移した
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusTopics from '../components/FocusTopics.astro';
import FollowCta from '../components/FollowCta.astro';
import Icon from '../components/Icon.astro';
import ItemList from '../components/ItemList.astro';
import NewsTemperature from '../components/NewsTemperature.astro';
import PickList from '../components/PickList.astro';
import TodayChanges from '../components/TodayChanges.astro';
import TopicList from '../components/TopicList.astro';
import TrendWords from '../components/TrendWords.astro';
import { site } from '../config/site.ts';
import { formatDay } from '../lib/daily.ts';
import { jstDateKey } from '../lib/dates.ts';
import { getPicks } from '../lib/editorial.ts';
import { builtAt, formatDateTime, getItems, getSources, href, pickVaried } from '../lib/items.ts';
import { clampDescription, headlineTeaser } from '../lib/seo.ts';
import { HOT_SCORE_MIN, getHotTopics, getImportantTopics, getRisingTopics, getTodayCounts, getTrendWords } from '../lib/topics.ts';

// 🔥 今話題（話題度の順）
const hot = getHotTopics({ hours: 24, limit: 5 });
const hotIds = new Set(hot.map((topic) => topic.id));
// 🚀 急上昇（今話題に出したトピックは除く。少なければ除かない）
const risingResult = getRisingTopics({ limit: 12 });
const risingFresh = risingResult.topics.filter((entry) => !hotIds.has(entry.topic.id));
const rising = (risingFresh.length >= 3 ? risingFresh : risingResult.topics).slice(0, 5);
const gained = Object.fromEntries(rising.map((entry) => [entry.topic.id, entry.gained]));
// ⭐ 今日の5トピック（1ジャンル1件）
const focus = getImportantTopics({ hours: 24, limit: 5, perCategory: 1 });
// 🔤 注目ワード
const trends = getTrendWords(12);
// 新着（同じ掲載元は2件まで。時刻のタイムライン）
const latest = pickVaried(getItems(), 10, 2);
const counts = getTodayCounts();
const sourceCount = getSources().length;
// 編集部のピックアップ（管理画面で選んだ記事と、運営者のひとこと）
const picks = getPicks();
const today = formatDay(jstDateKey(builtAt));
const numberFormat = new Intl.NumberFormat('ja-JP');

const description = clampDescription(
  hot.length > 0
    ? `ニュースを「記事」ではなく「話題」で読む。${sourceCount}のメディアの記事を1時間ごとにトピックにまとめ、話題度・急上昇・各社の報道の違いと今日の変化を紹介。いま話題：${headlineTeaser(
        hot.map((topic) => topic.lead),
        2,
        22,
      )}`
    : site.description,
);
const home = new URL(href('/'), Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: home,
    logo: new URL(href('/icon-512.png'), Astro.site).toString(),
    ...(site.socialAccounts.length > 0 ? { sameAs: site.socialAccounts.map((account) => account.url) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: home,
    description: site.description,
    inLanguage: 'ja',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${new URL(href('/search/'), Astro.site)}?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
const tiles = [
  { href: '#hot-title', icon: 'heat', tone: 'is-heat', label: '今話題', value: counts.hot, note: `話題度${HOT_SCORE_MIN}以上` },
  { href: '#rising-title', icon: 'rise', tone: 'is-rise', label: '急上昇', value: counts.rising, note: `${counts.risingHours}時間で報道が増加` },
  { href: '#focus-title', icon: 'focus', tone: 'is-focus', label: '今日の注目', value: counts.focus, note: '多くの媒体・ジャンル' },
  { href: '#words-title', icon: 'word', tone: '', label: '注目ワード', value: counts.words, note: '急に増えた言葉' },
];
---

<BaseLayout current="" description={description} jsonLd={jsonLd} sidebar={{ hideRanking: true, hidePopular: true }}>
  <div class="stack home">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">
        {site.taglineParts.map((part) => (
          <span class="nb">{part}</span>
        ))}
      </h1>
      <p class="hero-sub">{site.subcopy}</p>
      <p class="hero-status">
        <span>24時間で<b class="num">{numberFormat.format(counts.articles)}</b>記事</span>
        <Icon name="right" size={14} class="hero-arrow" />
        <span><b class="num">{numberFormat.format(counts.topics)}</b>トピック</span>
      </p>
      <div class="hero-cta">
        <a class="cta cta-primary" href="#hot-title">
          <Icon name="heat" />
          今話題を見る
        </a>
        <a class="cta" href="#rising-title">
          <Icon name="rise" />
          急上昇を見る
        </a>
      </div>
      <p class="hero-updated">
        <span>{counts.media}媒体から集計</span>
        <span class="updated">最終更新 {formatDateTime(builtAt)}（1時間ごとに更新）</span>
        <span class="live-count" data-live-count hidden></span>
      </p>
      <p class="since" data-since-banner hidden></p>
    </section>

    <section class="panel today" aria-labelledby="today-title">
      <div class="panel-head">
        <h2 id="today-title">{today}のトピあつめ</h2>
        <span class="today-tag">TODAY</span>
      </div>
      <ul class="tiles">
        {
          tiles.map((tile) => (
            <li>
              <a class="tile" href={tile.href}>
                <span class:list={['tile-label', tile.tone]}>
                  <Icon name={tile.icon} />
                  {tile.label}
                </span>
                <span class="tile-value">
                  <b class="num">{tile.value}</b>件
                </span>
                <span class="tile-note">{tile.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel" aria-labelledby="temp-title">
      <div class="panel-head">
        <h2 id="temp-title">
          <Icon name="heat" class="h-icon is-heat" />
          今日のニュースの温度
        </h2>
        <a class="more" href={href('/genres/')}>ジャンル →</a>
      </div>
      <p class="definition">ジャンルごとのトピックの熱さ（報じた媒体の数・新しさ・広がりの合計）。矢印は昨日の同じ時刻との比較です。</p>
      <NewsTemperature />
    </section>

    <section class="panel" aria-labelledby="changes-title">
      <div class="panel-head">
        <h2 id="changes-title">
          <Icon name="trend" class="h-icon" />
          今日、変化したこと
        </h2>
        <a class="more" href={href('/trends/')}>トレンド →</a>
      </div>
      <TodayChanges />
    </section>

    {
      picks.length > 0 && (
        <section class="panel" aria-labelledby="picks-title">
          <div class="panel-head">
            <h2 id="picks-title">編集部のピックアップ</h2>
          </div>
          <PickList picks={picks} />
        </section>
      )
    }

    {
      hot.length > 0 && (
        <section class="panel" aria-labelledby="hot-title">
          <div class="panel-head">
            <h2 id="hot-title">
              <Icon name="heat" class="h-icon is-heat" />
              今話題のトピック
            </h2>
            <a class="more" href={href('/ranking/')}>
              ランキング →
            </a>
          </div>
          <p class="definition">
            <b>話題度</b>＝今どれくらい話題か（報じた媒体の数・新しさ・ジャンルの広がり。0〜100）。「話題度」を押すと内訳が見られます。
          </p>
          <TopicList topics={hot} othersLimit={0} explain />
        </section>
      )
    }

    {
      rising.length > 0 && (
        <section class="panel" aria-labelledby="rising-title">
          <div class="panel-head">
            <h2 id="rising-title">
              <Icon name="rise" class="h-icon is-rise" />
              急上昇のトピック
            </h2>
            <a class="more" href={href('/rising/')}>
              すべて見る →
            </a>
          </div>
          <p class="definition">
            <b>急上昇</b>＝どれくらいの速さで広がっているか（直近{risingResult.hours}時間に新しく報じた媒体の数と、その前と比べたペース）。
          </p>
          <TopicList topics={rising.map((entry) => entry.topic)} gained={gained} gainedHours={risingResult.hours} othersLimit={0} momentum />
        </section>
      )
    }

    {
      focus.length > 0 && (
        <section class="panel" aria-labelledby="focus-title">
          <div class="panel-head">
            <h2 id="focus-title">
              <Icon name="focus" class="h-icon is-focus" />
              今日の5トピック
            </h2>
            <a class="more" href={href('/ranking/#today')}>
              今日の注目 →
            </a>
          </div>
          <p class="definition">
            忙しい人向けに「今日これだけ」。24時間に多くの媒体が報じ、ジャンルの広いトピックを1ジャンル1件ずつ選んでいます（ニュースの重要度を判断するものではありません）。
          </p>
          <FocusTopics topics={focus} />
        </section>
      )
    }

    {
      trends.length > 0 && (
        <section class="panel" aria-labelledby="words-title">
          <div class="panel-head">
            <h2 id="words-title">
              <Icon name="word" class="h-icon" />
              注目ワード
            </h2>
            <a class="more" href={href('/trends/')}>
              トレンド →
            </a>
          </div>
          <p class="definition">24時間の見出しに、それまでの7日間より急に増えた言葉（×はふだんの何倍か、「新」はふだんほとんど出てこない言葉）。</p>
          <TrendWords words={trends} />
          <form class="home-search" role="search" action={href('/search/')} method="get">
            <label class="visually-hidden" for="home-q">トピック・記事を検索</label>
            <input id="home-q" type="search" name="q" placeholder="気になる言葉でトピック・記事を探す" autocomplete="off" />
            <button type="submit" class="btn primary">検索</button>
          </form>
        </section>
      )
    }

    <section class="panel" aria-labelledby="latest-title">
      <div class="panel-head">
        <h2 id="latest-title">
          <Icon name="time" class="h-icon" />
          新着
        </h2>
        <a class="more" href={href('/latest/')}>すべて見る →</a>
      </div>
      <ItemList items={latest} group={false} showExcerpt={false} showCategory={false} timeline ads={false} />
    </section>

    <FollowCta />
  </div>
</BaseLayout>

<style>
  /* ===== ファーストビュー（コピー・今日の状態・入口） ===== */
  .hero {
    padding: 6px 2px 2px;
  }
  .hero h1 {
    margin: 0;
    /* 狭い画面でもキャッチコピーを言葉の途中で折り返さない大きさに */
    font-size: clamp(1.4rem, 6.2vw, var(--fs-display));
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .hero-sub {
    margin: 10px 0 0;
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: 1.75;
  }
  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 14px 0 0;
    font-size: var(--fs-body);
  }
  .hero-status b {
    margin: 0 2px;
    font-size: 1.25rem;
  }
  .hero-status :global(.hero-arrow) {
    color: var(--muted);
  }
  .nb {
    display: inline-block;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .cta-primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .cta-primary:hover {
    background: var(--accent-strong);
    color: var(--on-accent);
  }
  .hero-updated {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  .updated {
    font-variant-numeric: tabular-nums;
  }
  .since {
    display: inline-block;
    margin: 10px 0 0;
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--focus) 12%, var(--surface));
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .since[hidden] {
    display: none;
  }

  /* ===== 今日のトピあつめ（TODAY の数） ===== */
  .today-tag {
    color: var(--muted);
    font-size: var(--fs-caption);
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 12px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  @media (min-width: 720px) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tile {
    display: grid;
    gap: 2px;
    height: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--text);
    text-decoration: none;
  }
  .tile:hover {
    border-color: var(--accent);
  }
  .tile-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-2);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .tile-label.is-heat :global(.icon) {
    color: var(--heat);
  }
  .tile-label.is-rise :global(.icon) {
    color: var(--rise);
  }
  .tile-label.is-focus :global(.icon) {
    color: var(--accent);
  }
  .tile-value {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .tile-value b {
    margin-right: 2px;
    color: var(--text);
    font-size: var(--fs-display);
    line-height: 1.2;
  }
  .tile-note {
    color: var(--muted);
    font-size: 0.6875rem;
  }

  /* ページ内の移動で、見出しが上のタブに隠れないように */
  .panel-head h2[id] {
    scroll-margin-top: 64px;
  }
  .more {
    font-size: var(--fs-small);
  }
  .home-search {
    display: flex;
    gap: 8px;
    padding: 0 16px 16px;
  }
  .home-search input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 16px;
  }
</style>

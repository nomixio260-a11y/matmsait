---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemList from '../components/ItemList.astro';
import RankingList from '../components/RankingList.astro';
import { categories, site } from '../config/site.ts';
import { builtAt, formatDateTime, getItems, getItemsByCategory, getRanking, href } from '../lib/items.ts';
import { clampDescription, headlineTeaser } from '../lib/seo.ts';

const latest = getItems().slice(0, 30);
const hot = getRanking({ hours: 24, limit: 5 });
const sections = categories
  .map((category) => ({ category, items: getItemsByCategory(category.slug).slice(0, 6) }))
  .filter((section) => section.items.length > 0);

const description = clampDescription(
  hot.length > 0
    ? `人気サイトの新着ニュースと、はてブで話題の記事を1時間ごとにまとめてお届け。いま話題：${headlineTeaser(hot, 2, 22)}`
    : site.description,
);
const home = new URL(href('/'), Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: home,
    logo: new URL(href('/icon-512.png'), Astro.site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: home,
    description: site.description,
    inLanguage: 'ja',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${new URL(href('/search/'), Astro.site)}?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout current="" description={description} jsonLd={jsonLd} sidebar={{ rankingWideOnly: true }}>
  <div class="stack">
    <section class="intro">
      <h1>{site.seoTitle}</h1>
      <p>
        {site.name}は、人気ニュースサイトの新着記事と、はてなブックマークで話題の記事を1時間ごとに自動でまとめています。
        <span class="updated">最終更新 {formatDateTime(builtAt)}</span>
      </p>
    </section>

    {
      hot.length > 0 && (
        <section class="panel narrow-only">
          <div class="panel-head">
            <h2>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="flame">
                <path
                  d="M12 2c1 3.5 5 6 5 11a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.7 1.2 2.7 2.3 3C10.6 8 11.3 5 12 2Z"
                  fill="currentColor"
                />
              </svg>
              いま話題の記事
            </h2>
            <a class="more" href={href('/ranking/')}>
              ランキング →
            </a>
          </div>
          <RankingList items={hot} />
        </section>
      )
    }

    <section class="panel">
      <div class="panel-head">
        <h2>新着記事</h2>
        <a class="more" href={href('/latest/')}>すべて見る →</a>
      </div>
      <ItemList items={latest} headingLevel={3} />
      <div class="panel-foot">
        <a href={href('/latest/')}>新着記事をもっと見る</a>
      </div>
    </section>

    <div class="cat-grid">
      {
        sections.map(({ category, items }) => (
          <section class="panel">
            <div class="panel-head">
              <h2>
                <span class="dot" style={`--c:${category.color}`} />
                {category.name}
              </h2>
              <a class="more" href={href(`/category/${category.slug}/`)}>
                もっと見る →
              </a>
            </div>
            <ItemList items={items} group={false} showCategory={false} showExcerpt={false} ads={false} />
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .intro h1 {
    margin: 0;
    font-size: 1.1rem;
  }
  .intro p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .updated {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .flame {
    color: var(--hot);
  }
  .cat-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 720px) {
    .cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .narrow-only {
      display: none;
    }
  }
</style>

---
/**
 * トピックのページ: 同じ出来事を報じた複数の媒体の記事を、ひとつのトピックとして理解できるようにする。
 * 何が起きたか（概要・10秒/30秒/2分）→ なぜ話題か → 各媒体はどう報じたか（AI 整理、なければ見出しの比較）→
 * いつ・どこが報じたか（タイムライン）→ どう広がったか → 話題度の推移といまの段階 → 関連するトピック・前後のニュース。
 * 数字と文はどれも報道の状況から機械的に作り、ニュースの価値や正しさは判断しない
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FollowCta from '../../components/FollowCta.astro';
import HeadlineCompare from '../../components/HeadlineCompare.astro';
import HeatTrend from '../../components/HeatTrend.astro';
import Icon from '../../components/Icon.astro';
import ItemList from '../../components/ItemList.astro';
import ReportTimeline from '../../components/ReportTimeline.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import SpreadSteps from '../../components/SpreadSteps.astro';
import SummaryLevels from '../../components/SummaryLevels.astro';
import TopicList from '../../components/TopicList.astro';
import TopicNotes from '../../components/TopicNotes.astro';
import { site } from '../../config/site.ts';
import { builtAt, faviconUrl, formatDateTime, getCategory, getItemsByCategory, href, siteOf } from '../../lib/items.ts';
import { mainTitle } from '../../lib/related.ts';
import { clampDescription } from '../../lib/seo.ts';
import { firstSentence } from '../../lib/summary-view.ts';
import { LIFECYCLE_LABELS } from '../../lib/topic-core.ts';
import { topicNoteFor } from '../../lib/topic-notes.ts';
import { wordPath, wordsOfItems } from '../../lib/words.ts';
import {
  getTopicViews,
  momentumText,
  relatedTopics,
  tagPath,
  topicLifecycle,
  topicMomentum,
  topicNeighbors,
  topicOverview,
  topicPath,
  topicScoreBreakdown,
  topicWhy,
  type TopicView,
} from '../../lib/topics.ts';

export const getStaticPaths = (() => getTopicViews().map((view) => ({ params: { id: view.id }, props: { view } }))) satisfies GetStaticPaths;

interface Props {
  view: TopicView;
}
const { view } = Astro.props;
const { lead } = view;
const category = getCategory(view.categories[0] ?? lead.category) ?? getCategory(lead.category);
const summary = view.summaries[0];
const url = new URL(href(topicPath(view.id)), Astro.site).toString();
const first = view.reports[0];
const firstSite = siteOf(first.item);
const now = builtAt.getTime();
const life = topicLifecycle(view);
const overview = topicOverview(view);
const why = topicWhy(view);
const breakdown = topicScoreBreakdown(view);
const pace = momentumText(topicMomentum(view, 3));
const notes = topicNoteFor(view.items);
// このトピックの見出しに出てくるキーワード（キーワードのページへ）
const words = wordsOfItems(view.items, 8);
const rising = view.growth.h3 >= 2;
const isNew = now - first.time < 6 * 60 * 60 * 1000;
const isLive = Date.parse(view.latestAt) > now - 24 * 60 * 60 * 1000;
const decimal = (value: number) => (Math.round(value * 10) / 10).toString();
const genreNames = view.categories.map((slug) => getCategory(slug)?.name ?? slug);

// 関連するトピック（見出しの似ているもの・同じテーマ）。なければ同じジャンルの話題のトピックを、見出しを分けて出す
const related = relatedTopics(view, 6, { sameGenre: false });
const genreTopics = related.length < 3 && category ? relatedTopics(view, 5 - related.length, { similar: false }).filter((topic) => !related.includes(topic)) : [];
const neighbors = topicNeighbors(view, 6);
const shownIds = new Set([
  ...view.items.map((item) => item.id),
  ...[...related, ...genreTopics].flatMap((topic) => topic.items.map((item) => item.id)),
  ...neighbors.map((item) => item.id),
]);
const latestInCategory = category
  ? getItemsByCategory(category.slug)
      .filter((item) => !shownIds.has(item.id))
      .slice(0, 5)
  : [];

// 題名は見出しの要点（サイト名などを除いて40字まで）と「N媒体の報道を比較」（検索結果で、比べられるページだと分かるように）
const headline = mainTitle(lead.title);
const shortHeadline = Array.from(headline).length > 40 ? `${Array.from(headline).slice(0, 39).join('')}…` : headline;
const breadcrumb = Array.from(headline).length > 30 ? `${Array.from(headline).slice(0, 29).join('')}…` : headline;
const title = `${shortHeadline}｜${view.coverage}媒体の報道を比較`;
const description = clampDescription(`${summary ? `${firstSentence(summary.summary)}` : ''}${overview.join('')}`);
const home = new URL(href('/'), Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    headline: Array.from(lead.title).slice(0, 110).join(''),
    description,
    url,
    inLanguage: 'ja',
    datePublished: view.firstAt,
    dateModified: view.latestAt,
    isPartOf: { '@type': 'WebSite', name: site.name, url: home },
    ...(view.tags.length > 0 ? { keywords: view.tags.map((tag) => tag.name).join(', ') } : {}),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: view.items.length,
      itemListElement: [...view.items]
        .sort((a, b) => a.publishedAt.localeCompare(b.publishedAt))
        .slice(0, 20)
        .map((item, index) => ({ '@type': 'ListItem', position: index + 1, url: item.url, name: item.title })),
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  current="ranking"
  jsonLd={jsonLd}
  noindex={!view.indexable}
  ogType="article"
  published={view.firstAt}
  modified={view.latestAt}
  breadcrumbs={[{ name: '話題のトピック', path: '/ranking/' }, { name: breadcrumb }]}
  sidebar={{ rankingWideOnly: true }}
>
  <article
    class="stack topic-page"
    data-article-view
    data-aid={lead.id}
    data-src={lead.sourceId}
    data-cat={lead.category}
    data-title={lead.title}
    data-url={lead.url}
  >
    <header class="topic-head">
      <p class="kicker">
        {
          category && (
            <a href={href(`/category/${category.slug}/`)}>
              <span class="dot" style={`--c:${category.color}`} />
              {category.name}
            </a>
          )
        }
        <span class:list={['state', 'state-stage', `stage-${life.stage}`]} title="トピックの段階（発生・拡大・ピーク・減少）">{LIFECYCLE_LABELS[life.stage]}</span>
        {
          rising && (
            <span class="state state-rise">
              <Icon name="rise" size={12} />
              急上昇中
            </span>
          )
        }
        {isNew && <span class="state state-new">NEW</span>}
        <span class="updated">
          最終更新 <time datetime={view.latestAt}>{formatDateTime(view.latestAt)}</time>
        </span>
      </p>
      <h1>{lead.title}</h1>
      <p class="overview">{overview.join('')}</p>

      <dl class="scorecard">
        <div class="cell cell-heat">
          <dt>
            <Icon name="heat" />
            話題度<small>今どれくらい話題か</small>
          </dt>
          <dd>
            <span class="value">
              <b class="num score-num">{view.score}</b><span class="score-max">/100</span>
              <span class="meter" style={`--s:${view.score}`} aria-hidden="true"></span>
            </span>
            <details class="breakdown">
              <summary>なぜこの話題度？</summary>
              <ul>
                <li>報道 {breakdown.reports}件（新しさで重みづけすると {decimal(breakdown.weighted)}件。12時間ごとに半分）</li>
                {breakdown.genres > 1 && <li>ジャンルの広がり ×{decimal(breakdown.spread)}（{breakdown.genres}ジャンル）</li>}
                {breakdown.readsBonus > 0 && <li>トピあつめで読まれた数 +{decimal(breakdown.readsBonus)}</li>}
              </ul>
              <a href={href('/about/#score')}>計算のしかた</a>
            </details>
          </dd>
        </div>
        <div class="cell">
          <dt>
            <Icon name="media" />
            報じた媒体
          </dt>
          <dd>
            <span class="value">
              <b class="num">{view.coverage}</b>媒体
            </span>
            <span class="cell-note">{genreNames.length > 1 ? `${genreNames.length}ジャンル（${genreNames.slice(0, 3).join('・')}）` : genreNames[0]}</span>
          </dd>
        </div>
        <div class="cell cell-rise">
          <dt>
            <Icon name="rise" />
            急上昇<small>広がる速さ</small>
          </dt>
          <dd>
            <span class="value">
              <b class="num">{view.growth.h3 > 0 ? `+${view.growth.h3}` : '0'}</b>媒体<span class="unit">／3時間</span>
            </span>
            <span class="cell-note">{view.growth.h3 > 0 ? `${pace.spread}${pace.pace ? `・${pace.pace}` : ''}` : '直近3時間に新しく報じた媒体はありません'}</span>
          </dd>
        </div>
        <div class="cell">
          <dt>
            <Icon name="first" />
            初報<small>最初に確認できた報道</small>
          </dt>
          <dd>
            <span class="value first-source">
              <img src={faviconUrl(firstSite.host)} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              {firstSite.label}
            </span>
            <span class="cell-note">
              <time datetime={first.item.publishedAt}>{formatDateTime(first.item.publishedAt)}</time>
            </span>
          </dd>
        </div>
      </dl>
      {
        (view.tags.length > 0 || words.length > 0) && (
          <ul class="tag-chips" aria-label="テーマとキーワード">
            {view.tags.map((tag) => (
              <li>
                <a href={href(tagPath(tag.slug))}>#{tag.name}</a>
              </li>
            ))}
            {words.map((word) => (
              <li>
                <a class="word-chip" href={href(wordPath(word.slug))} title={`「${word.word}」のニュース・トピック`}>
                  {word.word}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <section class="panel" aria-labelledby="why-title">
      <div class="panel-head">
        <h2 id="why-title">
          <Icon name="why" class="h-icon" />
          なぜ話題？
        </h2>
      </div>
      <p class="why-text">{why}</p>
    </section>

    {summary && <SummaryLevels record={summary} others={view.summaries.slice(1)} topic={view} linkSummary initial="10" />}

    <section class="panel" aria-labelledby="views-title">
      <div class="panel-head">
        <h2 id="views-title">
          <Icon name="compare" class="h-icon" />
          各メディアの視点
        </h2>
        <span class="note">{notes ? 'AIによる整理' : '見出しの比較'}</span>
      </div>
      {
        notes ? (
          <>
            <TopicNotes notes={notes} />
            <details class="sub-details">
              <summary>各媒体の見出しを比べる</summary>
              <HeadlineCompare view={view} />
            </details>
          </>
        ) : (
          <HeadlineCompare view={view} />
        )
      }
    </section>

    <section class="panel" aria-labelledby="timeline-title">
      <div class="panel-head">
        <h2 id="timeline-title">
          <Icon name="timeline" class="h-icon" />
          報道タイムライン
        </h2>
        <span class="note">報じた順・{view.items.length}件</span>
      </div>
      <ReportTimeline view={view} />
    </section>

    <section class="panel" aria-labelledby="spread-title">
      <div class="panel-head">
        <h2 id="spread-title">
          <Icon name="spread" class="h-icon is-rise" />
          報道の広がり
        </h2>
        <span class="note">{isLive ? '1時間ごとに更新' : `${formatDateTime(view.latestAt)}まで`}</span>
      </div>
      <SpreadSteps view={view} />
    </section>

    <section class="panel" aria-labelledby="trend-title">
      <div class="panel-head">
        <h2 id="trend-title">
          <Icon name="trend" class="h-icon is-heat" />
          話題度の推移
        </h2>
        <a class="more" href={href('/about/#score')}>計算のしかた →</a>
      </div>
      <HeatTrend view={view} />
    </section>

    <ShareButtons url={url} text={`${shortHeadline}（${view.coverage}媒体が報道）｜${site.name}`} />
    <FollowCta text="話題になり始めたニュースを、Bluesky でいち早くお届けします。" />

    {
      related.length > 0 && (
        <section class="panel" aria-labelledby="related-title">
          <div class="panel-head">
            <h2 id="related-title">関連するトピック</h2>
            <a class="more" href={href('/ranking/')}>
              ランキング →
            </a>
          </div>
          <TopicList topics={related} othersLimit={0} ranked={false} />
        </section>
      )
    }

    {
      genreTopics.length > 0 && category && (
        <section class="panel" aria-labelledby="genre-topics-title">
          <div class="panel-head">
            <h2 id="genre-topics-title">{category.name}の話題のトピック</h2>
            <a class="more" href={href(`/category/${category.slug}/`)}>
              {category.name} →
            </a>
          </div>
          <TopicList topics={genreTopics} othersLimit={0} ranked={false} />
        </section>
      )
    }

    {
      neighbors.length > 0 && (
        <section class="panel" aria-labelledby="neighbors-title">
          <div class="panel-head">
            <h2 id="neighbors-title">前後のニュース</h2>
            <span class="note">見出しの似ている記事</span>
          </div>
          <ItemList items={neighbors} group={false} showExcerpt={false} ads={false} />
        </section>
      )
    }

    {
      latestInCategory.length > 0 && category && (
        <section class="panel" aria-labelledby="latest-title">
          <div class="panel-head">
            <h2 id="latest-title">{category.name}の新着</h2>
            <a class="more" href={href(`/category/${category.slug}/`)}>
              もっと見る →
            </a>
          </div>
          <ItemList items={latestInCategory} group={false} showCategory={false} showExcerpt={false} ads={false} />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .topic-head h1 {
    margin: 8px 0 0;
    font-size: var(--fs-h1, 1.35rem);
    line-height: 1.5;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    font-size: var(--fs-caption);
    color: var(--muted);
  }
  .kicker a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-weight: 700;
    text-decoration: none;
  }
  .kicker a:hover {
    text-decoration: underline;
  }
  .kicker .updated {
    font-variant-numeric: tabular-nums;
  }
  .state-stage {
    background: var(--heat-soft);
    color: var(--heat);
  }
  .stage-declining {
    background: var(--surface-2);
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .overview {
    margin: 10px 0 0;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }
  .scorecard {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 14px 0 0;
  }
  @media (min-width: 720px) {
    .scorecard {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .cell {
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .cell dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 4px;
    color: var(--muted);
    font-size: var(--fs-caption);
    font-weight: 700;
  }
  .cell dt small {
    flex-basis: 100%;
    font-size: 0.6875rem;
    font-weight: 400;
  }
  .cell-heat dt :global(.icon) {
    color: var(--heat);
  }
  .cell-rise dt :global(.icon) {
    color: var(--rise);
  }
  .cell dd {
    margin: 4px 0 0;
    color: var(--text-2);
    font-size: var(--fs-small);
  }
  .cell .value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 6px;
  }
  .cell dd b {
    color: var(--text);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.1;
  }
  .cell-heat .score-num {
    color: var(--heat);
  }
  .cell-rise dd b {
    color: var(--rise);
  }
  .score-max,
  .unit {
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  .cell .meter {
    flex-basis: 100%;
  }
  .cell-note {
    display: block;
    margin: 4px 0 0;
    color: var(--muted);
    font-size: var(--fs-caption);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .cell .first-source {
    align-items: center;
    color: var(--text);
    font-weight: 800;
    overflow-wrap: anywhere;
  }
  .first-source img {
    border-radius: 3px;
  }
  .breakdown {
    margin-top: 6px;
    font-size: var(--fs-caption);
    color: var(--text-2);
    line-height: 1.6;
  }
  .breakdown summary {
    color: var(--accent);
    font-weight: 700;
    cursor: pointer;
  }
  .breakdown ul {
    margin: 4px 0;
    padding-left: 1.1em;
  }
  .breakdown a {
    color: var(--accent);
  }
  .tag-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
  }
  .tag-chips a {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--fs-caption);
    font-weight: 600;
    text-decoration: none;
  }
  .tag-chips a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tag-chips .word-chip {
    border-style: dashed;
  }
  .note {
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  .why-text {
    margin: 0;
    padding: 12px 16px 14px;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.8;
  }
  .sub-details {
    border-top: 1px solid var(--border);
  }
  .sub-details > summary {
    padding: 12px 16px;
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 700;
    cursor: pointer;
  }
</style>

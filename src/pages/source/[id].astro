---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemList from '../../components/ItemList.astro';
import { getCategory, getItemsBySource, getSources } from '../../lib/items.ts';
import type { Source } from '../../lib/types.ts';

export const getStaticPaths = (() =>
  getSources().map((source) => ({ params: { id: source.id }, props: { source } }))) satisfies GetStaticPaths;

interface Props {
  source: Source;
}
const { source } = Astro.props;
const category = getCategory(source.category);
const items = getItemsBySource(source.id).slice(0, 50);
const description = `${source.name}の新着記事一覧`;
---

<BaseLayout title={source.name} description={description} current={source.category}>
  <h1>{source.name}</h1>
  <p class="lead">
    {category?.name} ・
    <a href={source.siteUrl} target="_blank" rel="noopener">公式サイトを見る</a>
  </p>
  <ItemList items={items} />
</BaseLayout>

<style>
  .lead a {
    color: var(--accent);
  }
</style>

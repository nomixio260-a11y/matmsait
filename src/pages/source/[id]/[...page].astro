---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ItemList from '../../../components/ItemList.astro';
import Pagination from '../../../components/Pagination.astro';
import { site } from '../../../config/site.ts';
import { getCategory, getItemsBySource, getSources, href } from '../../../lib/items.ts';
import { clampDescription, collectionJsonLd, headlineTeaser } from '../../../lib/seo.ts';
import type { Item, Source } from '../../../lib/types.ts';

export const getStaticPaths = (({ paginate }) =>
  getSources().flatMap((source) =>
    paginate(getItemsBySource(source.id), {
      pageSize: site.pageSize,
      params: { id: source.id },
      props: { source },
    }),
  )) satisfies GetStaticPaths;

interface Props {
  page: Page<Item>;
  source: Source;
}
const { page, source } = Astro.props;
const category = getCategory(source.category);
const suffix = page.currentPage > 1 ? `（${page.currentPage}ページ目）` : '';
const title = `${source.name}の最新記事一覧${suffix}`;
const description = clampDescription(
  `${source.name}の最新記事をまとめて表示しています。最新：${headlineTeaser(page.data, 2, 24)}など。`,
);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [collectionJsonLd({ name: title, description, url, items: page.data.slice(0, 10) })];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  current={source.category}
  noindex={page.currentPage > 1}
  breadcrumbs={[{ name: '掲載元一覧', path: '/sources/' }, { name: source.name }]}
>
  <div class="page-head">
    <h1>{source.name}の最新記事{suffix}</h1>
    <p>
      {category && <a href={href(`/category/${category.slug}/`)}>{category.name}</a>}
      ・{page.total}件 ・
      <a href={source.siteUrl} target="_blank" rel="noopener">公式サイトを見る</a>
    </p>
  </div>
  <div class="panel">
    <ItemList items={page.data} showCategory={false} />
  </div>
  <Pagination page={page} />
</BaseLayout>

<style>
  .page-head a {
    color: var(--accent);
  }
</style>

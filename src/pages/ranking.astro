---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImportantList from '../components/ImportantList.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TopicList from '../components/TopicList.astro';
import { categories, site } from '../config/site.ts';
import { getSources, href } from '../lib/items.ts';
import { clampDescription, collectionJsonLd, headlineTeaser } from '../lib/seo.ts';
import { getHotTopics, getImportantTopics } from '../lib/topics.ts';

// 24時間は話題度スコアの順（新しさも入る）、1週間は報じたメディアの数の順
const daily = getHotTopics({ hours: 24, limit: 30 });
const weekly = getHotTopics({ hours: 24 * 7, limit: 30, sort: 'coverage' });
// 今日の重要ニュース（ジャンルごとに3件まで）
const important = getImportantTopics({ hours: 24, limit: 15, perCategory: 3 });
const byCategory = categories
  .map((category) => ({ category, topics: getHotTopics({ hours: 72, category: category.slug, limit: 5 }) }))
  .filter((entry) => entry.topics.length > 0);

const title = '話題のニュースランキング（多くのメディアが報じたニュース）';
const description = clampDescription(
  daily.length > 0
    ? `複数のニュースサイトが報じた「いま話題のニュース」を、報じたメディアの数でランキング。1位${headlineTeaser(
        daily.map((topic) => topic.lead),
        1,
        30,
      )}ほか、24時間・1週間・カテゴリ別の話題を1時間ごとに更新。`
    : '複数のニュースサイトが報じた話題のニュースを、報じたメディアの数でランキングしています。',
);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [collectionJsonLd({ name: title, description, url, items: daily.slice(0, 10).map((topic) => topic.lead) })];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  current="ranking"
  breadcrumbs={[{ name: '話題のニュース' }]}
  sidebar={{ hideRanking: true }}
>
  <div class="page-head">
    <h1>話題のニュースランキング</h1>
    <p>
      {site.name}が記事を掲載している{getSources().length}のメディアのうち、同じ出来事を報じたメディアが多く、新しいニュースほど上位にしています（話題度スコア）。見出しを押すと、各メディアの報道を報じた順に比べられます（1時間ごとに更新）。
    </p>
    <p class="links">
      <a href={href('/rising/')}>🚀 急上昇</a>
      <a href={href('/tag/ai/')}>🤖 AIニュースランキング</a>
      <a href={href('/tags/')}># タグ一覧</a>
    </p>
  </div>

  <div class="stack">
    <ShareButtons url={url} text={`いま話題のニュースランキング｜${site.name}`} />
    <section class="panel">
      <div class="panel-head">
        <h2>話題のニュース</h2>
        <div class="seg" role="tablist" aria-label="集計期間">
          <button type="button" role="tab" aria-selected="true" aria-controls="rank-daily" id="tab-daily">24時間</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="rank-weekly" id="tab-weekly">1週間</button>
        </div>
      </div>
      <div id="rank-daily" role="tabpanel" aria-labelledby="tab-daily">
        {
          daily.length > 0 ? (
            <TopicList topics={daily} detailed />
          ) : (
            <p class="empty">いまは複数のサイトが報じた話題がありません。しばらくお待ちください。</p>
          )
        }
      </div>
      <div id="rank-weekly" role="tabpanel" aria-labelledby="tab-weekly" hidden>
        <p class="tab-note">1週間に報じたメディアの多い順</p>
        {
          weekly.length > 0 ? (
            <TopicList topics={weekly} detailed />
          ) : (
            <p class="empty">集計中です。しばらくお待ちください。</p>
          )
        }
      </div>
    </section>

    {
      important.length > 0 && (
        <section class="panel" id="today" aria-labelledby="today-title">
          <div class="panel-head">
            <h2 id="today-title">
              <span aria-hidden="true">📰</span>今日の重要ニュース
            </h2>
            <span class="note">ジャンルごとに3件まで</span>
          </div>
          <p class="tab-note">24時間に報じたメディアの数と、報じたメディアのジャンルの広がりの順です。</p>
          <ImportantList topics={important} />
        </section>
      )
    }

    <div class="cat-grid">
      {
        byCategory.map(({ category, topics }) => (
          <section class="panel">
            <div class="panel-head">
              <h2>
                <span class="dot" style={`--c:${category.color}`} />
                {category.name}の話題
              </h2>
              <a class="more" href={href(`/category/${category.slug}/`)}>
                新着を見る →
              </a>
            </div>
            <TopicList topics={topics} othersLimit={1} />
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px !important;
  }
  .links a {
    padding: 4px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }
  .links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tab-note {
    margin: 0;
    padding: 8px 16px 0;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .note {
    color: var(--muted);
    font-size: 0.75rem;
  }
  #today {
    scroll-margin-top: 64px;
  }
  .cat-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 720px) {
    .cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

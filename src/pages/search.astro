---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../config/site.ts';
import { getSources, href } from '../lib/items.ts';

const categoryData = JSON.stringify(categories.map(({ slug, name, color }) => ({ slug, name, color })));
// 掲載元のホスト名 → ID（検索結果の「表示しない設定」と記事のメニューに使う）
const sourceHosts = JSON.stringify(Object.fromEntries(getSources().map((source) => [new URL(source.siteUrl).hostname.replace(/^www\./, ''), source.id])));
const base = href('');
---

<BaseLayout title="トピック・記事を検索" description="トピック（同じ出来事の報道のまとまり）・キーワード・記事とAI要約を検索できます。" noindex breadcrumbs={[{ name: '検索' }]}>
  <div class="page-head">
    <h1>トピック・記事を検索</h1>
    <p>
      トピック・キーワード・記事（見出し・AI要約・抜粋・掲載元）から探せます。スペースで区切ると、すべての言葉を含むものに絞り込みます。「今日 急上昇 AI」のように、期間（今日・今週）・並べ方（急上昇・話題・新着）・ジャンルの名前も一緒に入力できます。
    </p>
  </div>

  <form id="search-form" class="search-box" role="search" aria-label="記事検索" action={href('/search/')} method="get">
    <input id="q" type="search" name="q" placeholder="例: 大谷翔平、今日 急上昇 AI" aria-label="検索キーワード" autocomplete="off" />
    <button type="submit">検索</button>
  </form>

  <div class="filters" role="group" aria-label="絞り込み">
    <label>
      <span>カテゴリ</span>
      <select id="f-category">
        <option value="">すべて</option>
        {categories.map((category) => <option value={category.slug}>{category.name}</option>)}
      </select>
    </label>
    <label>
      <span>期間</span>
      <select id="f-period">
        <option value="">すべて</option>
        <option value="1">24時間以内</option>
        <option value="3">3日以内</option>
        <option value="7">1週間以内</option>
      </select>
    </label>
    <label>
      <span>並び順</span>
      <select id="f-sort">
        <option value="">関連度順</option>
        <option value="new">新しい順</option>
      </select>
    </label>
    <label class="check">
      <input id="f-summary" type="checkbox" />
      <span>AI要約のある記事だけ</span>
    </label>
  </div>

  <section id="suggest" class="suggest" hidden aria-labelledby="suggest-title">
    <h2 id="suggest-title">よく出てくるキーワード</h2>
    <ul id="suggest-list"></ul>
  </section>

  <p id="search-status" class="search-status" aria-live="polite"></p>
  <p id="search-conditions" class="search-conditions" hidden></p>
  <section id="topic-results" class="panel topic-results" hidden aria-labelledby="topic-results-title">
    <div class="panel-head">
      <h2 id="topic-results-title">トピック</h2>
      <span class="note" id="topic-count"></span>
    </div>
    <ol id="topic-list" class="search-topics"></ol>
  </section>
  <section id="word-results" class="word-results" hidden aria-labelledby="word-results-title">
    <h2 id="word-results-title">キーワード</h2>
    <ul id="word-list"></ul>
  </section>
  <h2 id="article-title" class="article-title" hidden>記事</h2>
  <p id="search-follow" class="search-follow" hidden>
    <button type="button" class="follow-btn" id="follow-query" data-on="false">
      <span class="icon-off" aria-hidden="true">＋</span><span class="icon-on" aria-hidden="true">✓</span>
      <span class="follow-label">フォローする</span>
    </button>
    <span>この言葉が見出しに入った新着を「フォロー中」にまとめます（通知でも受け取れます）</span>
  </p>
  <div id="results-panel" class="panel" hidden>
    <ul id="results" class="items detailed" data-base={base} data-categories={categoryData} data-sources={sourceHosts}></ul>
  </div>
  <p id="more-wrap" class="more-wrap" hidden><button id="more" type="button">さらに表示</button></p>
</BaseLayout>

<script>
  import {
    highlightParts,
    interpretQuery,
    matchPlace,
    matchWords,
    rankEntries,
    rankTopics,
    type SearchEntry,
    type TopicEntry,
    type WordEntry,
  } from '../lib/search-core.ts';
  import { moreButton as itemMenuButton, syncFollowButtons } from '../scripts/personal.ts';

  interface CategoryData {
    slug: string;
    name: string;
    color: string;
  }

  const PAGE = 50;
  const form = document.querySelector<HTMLFormElement>('#search-form')!;
  const input = document.querySelector<HTMLInputElement>('#q')!;
  const fCategory = document.querySelector<HTMLSelectElement>('#f-category')!;
  const fPeriod = document.querySelector<HTMLSelectElement>('#f-period')!;
  const fSort = document.querySelector<HTMLSelectElement>('#f-sort')!;
  const fSummary = document.querySelector<HTMLInputElement>('#f-summary')!;
  const status = document.querySelector<HTMLElement>('#search-status')!;
  const panel = document.querySelector<HTMLElement>('#results-panel')!;
  const list = document.querySelector<HTMLUListElement>('#results')!;
  const moreWrap = document.querySelector<HTMLElement>('#more-wrap')!;
  const moreButton = document.querySelector<HTMLButtonElement>('#more')!;
  const suggest = document.querySelector<HTMLElement>('#suggest')!;
  const suggestList = document.querySelector<HTMLUListElement>('#suggest-list')!;
  const base = list.dataset.base ?? '';
  const categoryBySlug = new Map(
    (JSON.parse(list.dataset.categories ?? '[]') as CategoryData[]).map((c) => [c.slug, c]),
  );
  const sourceByHost = new Map(Object.entries(JSON.parse(list.dataset.sources ?? '{}') as Record<string, string>));
  const followWrap = document.querySelector<HTMLElement>('#search-follow')!;
  const followButton = document.querySelector<HTMLButtonElement>('#follow-query')!;
  const dateFormat = new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    month: 'numeric',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });

  const conditionsLine = document.querySelector<HTMLElement>('#search-conditions')!;
  const topicResults = document.querySelector<HTMLElement>('#topic-results')!;
  const topicList = document.querySelector<HTMLOListElement>('#topic-list')!;
  const topicCount = document.querySelector<HTMLElement>('#topic-count')!;
  const wordResults = document.querySelector<HTMLElement>('#word-results')!;
  const wordList = document.querySelector<HTMLUListElement>('#word-list')!;
  const articleTitle = document.querySelector<HTMLElement>('#article-title')!;
  const categoryList = [...categoryBySlug.values()];
  const TOPICS_SHOWN = 5;
  const PLACE_LABELS = { title: '見出しに一致', keywords: 'AI要約のキーワードに一致', summary: 'AI要約に一致', excerpt: '抜粋に一致', site: '掲載元に一致' } as const;

  // トピックとキーワードの小さな索引（ページを開いたらすぐ読む）
  let topicsPromise: Promise<{ topics: TopicEntry[]; words: WordEntry[] }> | undefined;
  function loadTopics(): Promise<{ topics: TopicEntry[]; words: WordEntry[] }> {
    topicsPromise ??= fetch(`${base}/search-topics.json`).then((res) => {
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json() as Promise<{ topics: TopicEntry[]; words: WordEntry[] }>;
    });
    topicsPromise.catch(() => (topicsPromise = undefined));
    return topicsPromise;
  }

  function renderTopic(topic: TopicEntry): HTMLLIElement {
    const li = el('li');
    const link = el('a', 'search-topic-title', topic.t);
    link.href = `${base}/topic/${topic.i}/`;
    const meta = el('p', 'search-topic-meta');
    meta.append(el('span', 'heat', `話題度 ${topic.sc}`), el('span', undefined, `${topic.v}媒体が報道`));
    if (topic.g > 0) meta.append(el('span', 'rise', `3時間で+${topic.g}媒体`));
    meta.append(el('span', undefined, dateFormat.format(new Date(topic.d))));
    li.append(link, meta);
    return li;
  }

  let indexPromise: Promise<SearchEntry[]> | undefined;
  function loadIndex(): Promise<SearchEntry[]> {
    indexPromise ??= fetch(`${base}/search-index.json`).then((res) => {
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json() as Promise<SearchEntry[]>;
    });
    indexPromise.catch(() => (indexPromise = undefined));
    return indexPromise;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  /** 一致した部分を <mark> で囲む（記事タイトルは外部由来なので textContent で組み立てる） */
  function appendHighlighted(target: HTMLElement, text: string, terms: string[]) {
    for (const part of highlightParts(text, terms)) {
      target.append(part.match ? el('mark', undefined, part.text) : part.text);
    }
  }

  function renderRow(entry: SearchEntry, terms: string[]): HTMLLIElement {
    const place = matchPlace(entry, terms);
    const li = el('li', 'item');
    // 記事のメニュー（…）と「表示しない設定」に使う
    li.dataset.id = entry.i;
    li.dataset.at = entry.d;
    li.dataset.cat = entry.c;
    li.dataset.srcName = entry.s;
    const sourceId = sourceByHost.get(entry.h);
    if (sourceId) li.dataset.src = sourceId;
    const categoryName = categoryBySlug.get(entry.c)?.name;
    if (categoryName) li.dataset.catName = categoryName;
    const title = el('a', 'item-title');
    // アクセス解析で、どの記事が開かれたかを数えるための印
    title.dataset.aid = entry.i;
    title.dataset.cat = entry.c;
    if (entry.m) {
      // AI 要約がある記事は当サイトの要約ページへ
      title.href = `${base}/summary/${entry.i}/`;
    } else {
      title.href = entry.u;
      title.target = '_blank';
      title.rel = 'noopener';
    }
    appendHighlighted(title, entry.t, terms);
    li.append(title);

    const snippet = entry.m ?? entry.e;
    if (snippet) {
      const p = el('p', entry.m ? 'item-excerpt item-summary' : 'item-excerpt');
      if (entry.m) p.append(el('span', 'ai-badge', 'AI要約'));
      appendHighlighted(p, snippet, terms);
      li.append(p);
    }

    const meta = el('div', 'item-meta');
    const site = el('span', 'item-site');
    const icon = el('img');
    icon.src = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(entry.h)}&sz=32`;
    icon.alt = '';
    icon.width = 16;
    icon.height = 16;
    icon.loading = 'lazy';
    icon.referrerPolicy = 'no-referrer';
    site.append(icon, el('span', undefined, entry.s));
    meta.append(site);

    const category = categoryBySlug.get(entry.c);
    if (category) {
      const link = el('a', 'item-cat');
      link.href = `${base}/category/${category.slug}/`;
      const dot = el('span', 'dot');
      dot.style.setProperty('--c', category.color);
      link.append(dot, category.name);
      meta.append(link);
    }

    const time = el('time', undefined, dateFormat.format(new Date(entry.d)));
    time.dateTime = entry.d;
    meta.append(time);

    if ((entry.v ?? 1) >= 2) {
      const coverage = el('span', 'coverage');
      coverage.title = 'この話題を報じた掲載元の数';
      coverage.append(el('b', undefined, String(entry.v)), '媒体が報道');
      meta.append(coverage);
    }
    if (entry.m) {
      const original = el('a', 'item-orig', '元記事 ↗');
      original.dataset.aid = entry.i;
      original.dataset.cat = entry.c;
      original.href = entry.u;
      original.target = '_blank';
      original.rel = 'noopener';
      meta.append(original);
    }
    if (place) meta.append(el('span', 'match-place', PLACE_LABELS[place]));
    if (sourceId) meta.append(itemMenuButton());
    li.append(meta);
    return li;
  }

  /** 検索した言葉をフォローするボタン（30文字まで） */
  function syncFollowQuery(words: string[]) {
    const word = words.join(' ');
    if (!word || Array.from(word).length > 30) {
      followWrap.hidden = true;
      return;
    }
    followButton.dataset.follow = JSON.stringify({ kind: 'word', value: word, label: word });
    followWrap.hidden = false;
    syncFollowButtons(followWrap);
  }

  async function showSuggestions() {
    try {
      // 候補は小さな索引のキーワード（記事の多い順）から出す。大きな記事の索引は検索したときに読む
      const { words: wordIndex } = await loadTopics();
      const keywords = [...wordIndex]
        .sort((a, b) => b.n - a.n)
        .slice(0, 12)
        .map((entry) => entry.w);
      suggestList.replaceChildren(
        ...keywords.map((keyword) => {
          const li = el('li');
          const a = el('a', undefined, keyword);
          a.href = `${base}/search/?q=${encodeURIComponent(keyword)}`;
          a.addEventListener('click', (event) => {
            event.preventDefault();
            input.value = keyword;
            update();
          });
          li.append(a);
          return li;
        }),
      );
      suggest.hidden = keywords.length === 0 || input.value.trim() !== '';
    } catch {
      suggest.hidden = true;
    }
  }

  let shown = PAGE;
  let sequence = 0;
  async function search() {
    const current = ++sequence;
    const query = input.value;
    // 「今日 急上昇 AI」のような入力を、条件（期間・並べ方・ジャンル・AI 要約）と検索語に分ける。絞り込みの欄で選んだ条件のほうを優先する
    const interpreted = interpretQuery(query, categoryList);
    const { words, terms } = interpreted;
    const category = fCategory.value || interpreted.category;
    const days = fPeriod.value ? Number(fPeriod.value) : interpreted.days;
    const summaryOnly = fSummary.checked || Boolean(interpreted.summaryOnly);
    const filtered = Boolean(category || days || summaryOnly || interpreted.kind);
    suggest.hidden = query.trim() !== '' || suggestList.children.length === 0;
    if (words.length === 0) followWrap.hidden = true;
    conditionsLine.hidden = interpreted.conditions.length === 0;
    conditionsLine.replaceChildren(
      el('span', 'conditions-label', '条件として読んだ言葉:'),
      ...interpreted.conditions.map((condition) => el('span', 'condition', `「${condition.word}」→ ${condition.meaning}`)),
    );
    if (words.length === 0 && !filtered) {
      list.replaceChildren();
      panel.hidden = true;
      moreWrap.hidden = true;
      topicResults.hidden = true;
      wordResults.hidden = true;
      articleTitle.hidden = true;
      status.textContent = 'キーワードを入力するか、絞り込みの条件を選んでください。';
      return;
    }
    status.textContent = '検索しています…';
    // トピックとキーワード（小さな索引なので先に出す）
    try {
      const { topics, words: wordIndex } = await loadTopics();
      if (current !== sequence) return;
      const topicHits = rankTopics(topics, { ...interpreted, category, days }, Date.now());
      topicList.replaceChildren(...topicHits.slice(0, TOPICS_SHOWN).map(renderTopic));
      topicCount.textContent = topicHits.length > TOPICS_SHOWN ? `${topicHits.length}件中${TOPICS_SHOWN}件` : `${topicHits.length}件`;
      topicResults.hidden = topicHits.length === 0;
      const wordHits = matchWords(wordIndex, terms);
      wordList.replaceChildren(
        ...wordHits.map((entry) => {
          const li = el('li');
          const a = el('a', undefined, entry.w);
          a.href = `${base}/word/${encodeURIComponent(entry.s)}/`;
          a.append(el('small', undefined, `${entry.n}件`));
          li.append(a);
          return li;
        }),
      );
      wordResults.hidden = wordHits.length === 0;
    } catch {
      topicResults.hidden = true;
      wordResults.hidden = true;
    }
    let index: SearchEntry[];
    try {
      index = await loadIndex();
    } catch {
      status.textContent = '検索データを読み込めませんでした。時間をおいてもう一度お試しください。';
      return;
    }
    if (current !== sequence) return;

    const hits = rankEntries(index, terms, {
      now: Date.now(),
      category: category || undefined,
      days,
      summaryOnly,
      sort: fSort.value === 'new' || interpreted.kind === 'new' ? 'new' : 'relevance',
    });
    const label = query.trim() ? `「${query.trim()}」の検索結果` : '絞り込みの結果';
    const topicTotal = topicResults.hidden ? 0 : topicList.children.length;
    // アクセス解析に検索した言葉と件数を知らせる（よく検索される言葉・見つからなかった言葉の把握に使う）
    if (query.trim()) document.dispatchEvent(new CustomEvent('tp:search', { detail: { q: query.trim(), n: hits.length } }));
    status.textContent =
      hits.length === 0 && topicTotal === 0 ? `${label}: 一致するトピック・記事は見つかりませんでした。` : `${label}: 記事${hits.length}件${topicTotal > 0 ? `（トピックは上に）` : ''}`;
    articleTitle.hidden = hits.length === 0;
    syncFollowQuery(words);
    list.replaceChildren(...hits.slice(0, shown).map((entry) => renderRow(entry, terms)));
    panel.hidden = hits.length === 0;
    moreWrap.hidden = hits.length <= shown;
  }

  function syncUrl() {
    const url = new URL(location.href);
    const params: [string, string][] = [
      ['q', input.value.trim()],
      ['c', fCategory.value],
      ['p', fPeriod.value],
      ['s', fSort.value],
      ['m', fSummary.checked ? '1' : ''],
    ];
    for (const [key, value] of params) {
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
    }
    history.replaceState(null, '', url);
  }

  function update() {
    shown = PAGE;
    syncUrl();
    void search();
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(update, 200);
  });
  for (const control of [fCategory, fPeriod, fSort, fSummary]) control.addEventListener('change', update);
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    clearTimeout(timer);
    update();
  });
  moreButton.addEventListener('click', () => {
    shown += PAGE;
    void search();
  });

  const params = new URLSearchParams(location.search);
  input.value = params.get('q') ?? '';
  fCategory.value = params.get('c') ?? '';
  fPeriod.value = params.get('p') ?? '';
  fSort.value = params.get('s') ?? '';
  fSummary.checked = params.get('m') === '1';
  if (!input.value) input.focus();
  void loadTopics().catch(() => undefined);
  void showSuggestions();
  void search();
</script>

<style>
  .search-follow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: -4px 0 12px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .search-follow[hidden] {
    display: none;
  }
  .search-box {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }
  .search-box input {
    flex: 1;
    min-width: 0;
    height: 46px;
    padding: 0 14px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  .search-box input:focus {
    outline: 2px solid var(--focus);
    outline-offset: 0;
  }
  .search-box button,
  .more-wrap button {
    height: 46px;
    padding: 0 20px;
    border: 0;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .search-box button:hover,
  .more-wrap button:hover {
    background: var(--accent-strong);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    align-items: center;
    margin-bottom: 4px;
    font-size: 0.82rem;
    color: var(--text-2);
  }
  .filters label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .filters select {
    height: 34px;
    padding: 0 8px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  .filters .check input {
    width: 16px;
    height: 16px;
    accent-color: var(--accent);
  }
  .suggest {
    margin: 14px 0 4px;
  }
  .suggest h2 {
    margin: 0 0 8px;
    font-size: 0.9rem;
  }
  .suggest ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .suggest a {
    display: inline-block;
    padding: 5px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-2);
    font-size: 0.82rem;
    text-decoration: none;
  }
  .suggest a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .search-status {
    margin: 12px 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .more-wrap {
    margin: 14px 0 0;
    text-align: center;
  }
  .search-conditions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: -4px 0 12px;
    font-size: var(--fs-caption);
  }
  .search-conditions[hidden] {
    display: none;
  }
  :global(.search-conditions .conditions-label) {
    color: var(--muted);
  }
  :global(.search-conditions .condition) {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--rise-soft);
    color: var(--rise);
    font-weight: 700;
  }
  .topic-results {
    margin-bottom: 14px;
  }
  .note {
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  .search-topics {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  :global(.search-topics li) {
    padding: 10px 16px;
  }
  :global(.search-topics li + li) {
    border-top: 1px solid var(--border);
  }
  :global(.search-topic-title) {
    color: var(--text);
    font-weight: 700;
    line-height: 1.55;
    text-decoration: none;
  }
  :global(.search-topic-title:hover) {
    color: var(--accent);
    text-decoration: underline;
  }
  :global(.search-topic-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    margin: 4px 0 0;
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  :global(.search-topic-meta .heat) {
    color: var(--heat);

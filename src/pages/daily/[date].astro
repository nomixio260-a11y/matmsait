---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DayAnalysis from '../../components/DayAnalysis.astro';
import ItemList from '../../components/ItemList.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { categories, site } from '../../config/site.ts';
import { dailyPath, formatDay, getDailySnapshots } from '../../lib/daily.ts';
import { jstDateKey } from '../../lib/dates.ts';
import { builtAt, formatTime, href } from '../../lib/items.ts';
import { dailyImagePath } from '../../lib/og-cards.ts';
import { clampDescription, collectionJsonLd, headlineTeaser } from '../../lib/seo.ts';
import type { DailySnapshot } from '../../lib/types.ts';

export const getStaticPaths = (() => {
  const days = getDailySnapshots();
  return days.map((snapshot, index) => ({
    params: { date: snapshot.date },
    props: { snapshot, newer: days[index - 1]?.date, older: days[index + 1]?.date },
  }));
}) satisfies GetStaticPaths;

interface Props {
  snapshot: DailySnapshot;
  newer?: string;
  older?: string;
}
const { snapshot, newer, older } = Astro.props;
const label = formatDay(snapshot.date, true);
const shortLabel = formatDay(snapshot.date);
const isToday = snapshot.date === jstDateKey(builtAt);
// 多くの掲載元が報じた話題（同じ話題は1件だけ）
const ranked = snapshot.items.filter((item) => (item.coverage ?? 1) >= 2).slice(0, 20);
const sections = categories
  .map((category) => ({ category, items: snapshot.items.filter((item) => item.category === category.slug).slice(0, 5) }))
  .filter((section) => section.items.length > 0);

// その日の概要文（ページごとに異なる本文になるよう、件数や1位の記事から作る）
const breakdown = categories
  .map((category) => ({ name: category.name, count: snapshot.counts[category.slug] ?? 0 }))
  .filter((entry) => entry.count > 0)
  .sort((a, b) => b.count - a.count)
  .map((entry) => `${entry.name}${entry.count}件`)
  .join('、');
const top = ranked[0];
const summary = [
  `${shortLabel}は${isToday ? `${formatTime(builtAt.toISOString())}までに` : ''}合計${snapshot.total}件の記事を掲載${isToday ? 'しています' : 'しました'}（${breakdown}）。`,
  top ? `最も多くの媒体が報じたのは「${top.title}」（${top.coverage}媒体が報道）です。` : '',
].join('');

const title = `${label}の話題のニュースまとめ`;
const description = clampDescription(
  top
    ? `${label}に話題になったニュースまとめ。${headlineTeaser(ranked, 1, 34)}ほか、多くのメディアが報じたニュースとカテゴリ別の注目記事を紹介します。`
    : `${label}に掲載したニュースをカテゴリごとにまとめました。`,
);
const url = new URL(href(dailyPath(snapshot.date)), Astro.site).toString();
const jsonLd = [collectionJsonLd({ name: title, description, url, items: ranked.slice(0, 10), dateModified: snapshot.updatedAt })];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: '日別アーカイブ', path: '/daily/' }, { name: label }]}
  jsonLd={jsonLd}
  image={snapshot.items.length > 0 ? { path: dailyImagePath(snapshot.date), alt: `${label}の話題ニュース TOP5` } : undefined}
>
  <div class="page-head">
    <h1>{label}の話題のニュース</h1>
    <p class="summary">{summary}</p>
  </div>

  <div class="stack">
    <ShareButtons url={url} text={`${shortLabel}の話題のニュースまとめ｜${site.name}`} />

    <DayAnalysis date={snapshot.date} />

    {
      ranked.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h2>多くのメディアが報じたニュース</h2>
            <span class="note">報じたサイトの数の順</span>
          </div>
          <ItemList items={ranked} group={false} ads={false} />
        </section>
      )
    }

    <div class="cat-grid">
      {
        sections.map(({ category, items }) => (
          <section class="panel">
            <div class="panel-head">
              <h2>
                <span class="dot" style={`--c:${category.color}`} />
                {category.name}
              </h2>
              <span class="note">{snapshot.counts[category.slug] ?? 0}件</span>
            </div>
            <ItemList items={items} group={false} showCategory={false} showExcerpt={false} ads={false} />
          </section>
        ))
      }
    </div>

    <nav class="day-nav" aria-label="前後の日">
      {older ? <a href={href(dailyPath(older))} rel="prev">← {formatDay(older)}</a> : <span />}
      <a href={href('/daily/')}>日別アーカイブ</a>
      {newer ? <a href={href(dailyPath(newer))} rel="next">{formatDay(newer)} →</a> : <span />}
    </nav>
  </div>
</BaseLayout>

<style>
  .summary {
    margin-top: 8px !important;
    color: var(--text-2) !important;
    font-size: 0.9rem !important;
    line-height: 1.8;
  }
  .note {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cat-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 720px) {
    .cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .day-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 8px;
    align-items: center;
    font-size: 0.875rem;
  }
  .day-nav a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .day-nav a:hover {
    text-decoration: underline;
  }
  .day-nav a:last-child:not(:nth-child(2)) {
    text-align: right;
  }
</style>

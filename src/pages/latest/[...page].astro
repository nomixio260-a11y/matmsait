---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemList from '../../components/ItemList.astro';
import Pagination from '../../components/Pagination.astro';
import { site } from '../../config/site.ts';
import { getItems } from '../../lib/items.ts';
import type { Item } from '../../lib/types.ts';

export const getStaticPaths = (({ paginate }) => paginate(getItems(), { pageSize: site.pageSize })) satisfies GetStaticPaths;

interface Props {
  page: Page<Item>;
}
const { page } = Astro.props;
const suffix = page.currentPage > 1 ? `（${page.currentPage}ページ目）` : '';
---

<BaseLayout
  title={`すべての新着記事${suffix}`}
  description="全カテゴリの新着記事を新しい順にまとめています。"
  current=""
  noindex={page.currentPage > 1}
  breadcrumbs={[{ name: 'すべての新着' }]}
>
  <div class="page-head">
    <h1>すべての新着記事{suffix}</h1>
    <p>全カテゴリの新着記事を新しい順に表示しています（{page.total}件）。</p>
  </div>
  <div class="panel">
    <ItemList items={page.data} />
  </div>
  <Pagination page={page} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MediaStats from '../components/MediaStats.astro';
import { categories, site } from '../config/site.ts';
import { faviconUrl, getItemsBySource, getSources, href } from '../lib/items.ts';
import { getMediaStats } from '../lib/topics.ts';

const sources = getSources();
// メディア別（24時間。初報の多い順。トップページから移した）
const media = getMediaStats(24)
  .filter((stat) => stat.topics > 0)
  .slice(0, 20);
const groups = categories
  .map((category) => ({ category, sources: sources.filter((s) => s.category === category.slug) }))
  .filter((group) => group.sources.length > 0);
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<BaseLayout
  title="掲載元一覧"
  description={`${site.name}が新着記事を掲載しているサイトの一覧です。`}
  breadcrumbs={[{ name: '掲載元一覧' }]}
  current="sources"
>
  <div class="page-head">
    <h1>掲載元一覧</h1>
    <p>以下のサイトが公開しているRSSフィードから、記事の見出しと冒頭の短い抜粋を掲載しています（全{sources.length}サイト）。</p>
  </div>
  <div class="stack">
    {
      media.length > 0 && (
        <section class="panel" aria-labelledby="media-title">
          <div class="panel-head">
            <h2 id="media-title">
              <Icon name="media" class="h-icon" />
              24時間の報道（メディア別）
            </h2>
          </div>
          <p class="definition">
            24時間のトピックを、どの媒体が報じたか、最初に確認できた報道（<b>初報</b>）がどこだったかを数えています。初報の多い順です（最初に報じた媒体の内容が正しいとは限りません）。
          </p>
          <MediaStats stats={media} />
        </section>
      )
    }
    {
      groups.map(({ category, sources }) => (
        <section class="panel">
          <div class="panel-head">
            <h2>
              <span class="dot" style={`--c:${category.color}`} />
              {category.name}
            </h2>
          </div>
          <ul class="source-list">
            {sources.map((source) => (
              <li>
                <img src={faviconUrl(hostOf(source.siteUrl))} alt="" width="16" height="16" loading="lazy" referrerpolicy="no-referrer" />
                <a class="name" href={href(`/source/${source.id}/`)}>
                  {source.name}
                </a>
                {source.aggregator && <span class="tag">話題の記事</span>}
                <span class="count">{getItemsBySource(source.id).length}件</span>
                <a class="external" href={source.siteUrl} target="_blank" rel="noopener">
                  公式サイト ↗
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .source-list {
    list-style: none;
    margin: 0;
    padding: 4px 0;
  }
  .source-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    font-size: 0.9rem;
  }
  .source-list li + li {
    border-top: 1px solid var(--border);
  }
  img {
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }
  .name {
    font-weight: 600;
    text-decoration: none;
  }
  .name:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .tag {
    font-size: 0.68rem;
    padding: 0 6px;
    border-radius: 4px;
    background: var(--hot-soft);
    color: var(--hot);
  }
  .count {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .external {
    color: var(--accent);
    font-size: 0.78rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .external:hover {
    text-decoration: underline;
  }
</style>

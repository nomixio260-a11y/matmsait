---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemList from '../../components/ItemList.astro';
import Pagination from '../../components/Pagination.astro';
import { site } from '../../config/site.ts';
import { collectionJsonLd } from '../../lib/seo.ts';
import { getSummaries } from '../../lib/summaries.ts';
import type { SummaryRecord } from '../../lib/types.ts';

export const getStaticPaths = (({ paginate }) => paginate(getSummaries(), { pageSize: site.pageSize })) satisfies GetStaticPaths;

interface Props {
  page: Page<SummaryRecord>;
}
const { page } = Astro.props;
const suffix = page.currentPage > 1 ? `（${page.currentPage}ページ目）` : '';
const title = `AI要約つき記事一覧${suffix}`;
const description = '話題のニュースをAIが要約。記事のポイントを短時間でチェックできます。';
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [collectionJsonLd({ name: title, description, url, items: page.data.slice(0, 10) })];
---

<BaseLayout
  title={title}
  description={description}
  current="summaries"
  noindex={page.currentPage > 1 || page.total === 0}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'AI要約' }]}
>
  <div class="page-head">
    <h1>AI要約つき記事{suffix}</h1>
    <p>話題の記事のポイントをAIが要約しています（{page.total}件）。</p>
  </div>
  <div class="panel">
    <ItemList items={page.data} group={false} />
  </div>
  <Pagination page={page} />
</BaseLayout>

---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SummaryCard from '../../components/SummaryCard.astro';
import Pagination from '../../components/Pagination.astro';
import { site } from '../../config/site.ts';
import { href } from '../../lib/items.ts';
import { collectionJsonLd } from '../../lib/seo.ts';
import { getSummaries } from '../../lib/summaries.ts';
import type { SummaryRecord } from '../../lib/types.ts';

export const getStaticPaths = (({ paginate }) => paginate(getSummaries(), { pageSize: site.pageSize })) satisfies GetStaticPaths;

interface Props {
  page: Page<SummaryRecord>;
}
const { page } = Astro.props;
const suffix = page.currentPage > 1 ? `（${page.currentPage}ページ目）` : '';
const title = `AI要約つき記事一覧${suffix}`;
const description = '話題のニュースをAIが要約。記事のポイントを短時間でチェックできます。';
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [collectionJsonLd({ name: title, description, url, items: page.data.slice(0, 10) })];
---

<BaseLayout
  title={title}
  description={description}
  current="summaries"
  noindex={page.currentPage > 1 || page.total === 0}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'AI要約' }]}
  feeds={[{ title: 'AI要約', path: '/summaries/rss.xml' }]}
>
  <div class="page-head">
    <h1>AI要約つき記事{suffix}</h1>
    <p>
      話題の記事のポイントをAIが要約しています（{page.total}件）。要約の作り方は<a href={href('/editorial/')}>編集方針</a>をご覧ください。<a href={href('/summaries/rss.xml')}>RSS</a>でも購読できます。
    </p>
  </div>
  {
    page.data.length > 0 ? (
      <div class="card-grid">
        {page.data.map((record) => (
          <SummaryCard record={record} headingLevel={2} />
        ))}
      </div>
    ) : (
      <p class="empty">まだAI要約つきの記事はありません。</p>
    )
  }
  <Pagination page={page} />
</BaseLayout>

<style>
  .card-grid {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 620px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .page-head a {
    color: var(--accent);
  }
</style>

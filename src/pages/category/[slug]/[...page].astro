---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ItemList from '../../../components/ItemList.astro';
import SummaryCard from '../../../components/SummaryCard.astro';
import TopicList from '../../../components/TopicList.astro';
import Pagination from '../../../components/Pagination.astro';
import { categories, site, type Category } from '../../../config/site.ts';
import { getItemsByCategory, getSources, href, listItems } from '../../../lib/items.ts';
import { clampDescription, collectionJsonLd, headlineTeaser } from '../../../lib/seo.ts';
import { getSummaries } from '../../../lib/summaries.ts';
import { getHotTopics } from '../../../lib/topics.ts';
import type { Item } from '../../../lib/types.ts';

export const getStaticPaths = (({ paginate }) =>
  categories.flatMap((category) =>
    paginate(listItems(getItemsByCategory(category.slug)), {
      pageSize: site.pageSize,
      params: { slug: category.slug },
      props: { category },
    }),
  )) satisfies GetStaticPaths;

interface Props {
  page: Page<Item>;
  category: Category;
}
const { page, category } = Astro.props;
const suffix = page.currentPage > 1 ? `（${page.currentPage}ページ目）` : '';
const title = `${category.name}の最新ニュースまとめ${suffix}`;
const description = clampDescription(
  `${category.description}。最新：${headlineTeaser(page.data, 2, 24)}など${page.total}件を掲載中（1時間ごとに更新）。`,
);
const url = new URL(Astro.url.pathname, Astro.site).toString();
// 1ページ目だけ、このカテゴリの話題と AI 要約を上に出す（一覧だけのページにしない）
const first = page.currentPage === 1;
const topics = first ? getHotTopics({ hours: 72, category: category.slug, limit: 5 }) : [];
const summaries = first ? getSummaries().filter((record) => record.category === category.slug).slice(0, 4) : [];
const sourceNames = getSources()
  .filter((source) => source.category === category.slug)
  .map((source) => source.name);
const jsonLd = [collectionJsonLd({ name: title, description, url, items: page.data.slice(0, 10) })];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  feeds={[{ title: category.name, path: `/category/${category.slug}/rss.xml` }]}
  current={category.slug}
  noindex={page.currentPage > 1}
  breadcrumbs={[{ name: category.name }]}
  sidebar={{ category: category.slug }}
>
  <div class="page-head" data-scope-cat={category.slug}>
    <div class="title-row">
      <h1>
        <span class="dot" style={`--c:${category.color}`}></span>
        {category.name}の最新ニュース{suffix}
      </h1>
      <button
        type="button"
        class="follow-btn"
        data-follow={JSON.stringify({ kind: 'cat', value: category.slug, label: category.name })}
        data-on="false"
      >
        <span class="icon-off" aria-hidden="true">＋</span><span class="icon-on" aria-hidden="true">✓</span>
        <span class="follow-label">フォローする</span>
      </button>
    </div>
    <p>
      {category.description}（{page.total}件）・<a href={href(`/category/${category.slug}/rss.xml`)}>RSS</a>
    </p>
    {
      first && sourceNames.length > 0 && (
        <p class="sources">
          {sourceNames.slice(0, 12).join('・')}
          {sourceNames.length > 12 && `ほか${sourceNames.length - 12}サイト`}
          の新着記事を1時間ごとに集めています。
        </p>
      )
    }
  </div>
  <div class="stack">
    {
      topics.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h2>{category.name}の話題のトピック（複数の媒体が報道）</h2>
            <a class="more" href={href('/ranking/')}>
              話題のトピック →
            </a>
          </div>
          <TopicList topics={topics} />
        </section>
      )
    }
    {
      summaries.length > 0 && (
        <section aria-labelledby="cat-summaries">
          <h2 id="cat-summaries" class="section-title">
            <span class="ai-badge">AI要約</span>
            {category.name}のニュースのポイント
          </h2>
          <div class="card-grid">
            {summaries.map((record) => (
              <SummaryCard record={record} />
            ))}
          </div>
        </section>
      )
    }
    <section class="panel" aria-label={`${category.name}の新着記事`}>
      <ItemList items={page.data} showCategory={false} />
    </section>
  </div>
  <Pagination page={page} />
</BaseLayout>

<style>
  h1 {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  h1 .dot {
    width: 12px;
    height: 12px;
  }
  .page-head a {
    color: var(--accent);
  }
  .sources {
    font-size: 0.78rem !important;
  }
  .section-title {
    margin: 0 0 10px;
    font-size: 1.02rem;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .card-grid {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 620px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

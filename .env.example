# いずれも任意。GitHub ではリポジトリの Settings → Secrets and variables → Actions → Variables に登録する
# Google AdSense のパブリッシャーID（例: ca-pub-1234567890123456）
PUBLIC_ADSENSE_CLIENT=
# AdSense の広告ユニットのスロットID（記事一覧の途中・サイドバーに表示）
PUBLIC_ADSENSE_SLOT=
# Google アナリティクス 4 の測定ID（例: G-XXXXXXXXXX）
PUBLIC_GA_ID=
# Google Search Console の所有権確認コード（meta タグの content の値）
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Web マスターツールの所有権確認コード
PUBLIC_BING_SITE_VERIFICATION=
# アクセス解析のサーバーの URL（ふだんは data/analytics.json を使うので空でよい。手元で試すときは http://127.0.0.1:8787）
PUBLIC_ANALYTICS_URL=

# ↓ アクセス解析のサーバーの公開（GitHub では Secrets に登録する。README の「アクセス解析」）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ↓ SNS 自動投稿（GitHub では Variables ではなく Secrets に登録する）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
MASTODON_URL=
MASTODON_TOKEN=
MISSKEY_URL=
MISSKEY_TOKEN=

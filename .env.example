# いずれも任意。GitHub ではリポジトリの Settings → Secrets and variables → Actions → Variables に登録する
# Google AdSense のパブリッシャーID（例: ca-pub-1234567890123456）
PUBLIC_ADSENSE_CLIENT=
# AdSense の広告ユニットのスロットID（記事一覧の途中・サイドバーに表示）
PUBLIC_ADSENSE_SLOT=
# Google アナリティクス 4 の測定ID（例: G-XXXXXXXXXX）
PUBLIC_GA_ID=
# Google Search Console の所有権確認コード（meta タグの content の値）
PUBLIC_GOOGLE_SITE_VERIFICATION=
